append function_tag load {
    "values": [
        "load:load"
    ]
} 
function load:load:
    tellraw @a {"text":"Thank you for taking your Bittersweet Supplement!","color":"#c6b3c8"}
    tellraw @a {"text":"Lost? Check the Advancement Menu!","color":"#a990a9"}
    tellraw @a {"text":"Bittersweet Supplement for Java 26.2 by phantomfeign","color":"#87658a"}
    schedule function tick:call 1t
    schedule function tick_1s:call 2t

function load:scoreboards:
    scoreboard objectives add bswt.projectileMath dummy
#ENCHANTS
    scoreboard objectives add bswt.lacerationStacks dummy


