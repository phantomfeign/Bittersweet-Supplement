function bswt:mob_adjustment/zombie/spawn:
    attribute @s minecraft:attack_damage base set 3
    attribute @s minecraft:knockback_resistance base set 0.5
    attribute @s minecraft:follow_range base set 25
    attribute @s minecraft:step_height base set 1
    attribute @s minecraft:max_health base set 20
    data merge entity @s {Health:20.0f}

advancement temp:mob/zombie/hit_player {
  "parent":"temp:root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:entity_hurt_player",
      "conditions": {
        "damage": {
          "type": {
            "direct_entity": {
              "minecraft:entity_type": "minecraft:zombie"
            }
          }
        }
      }
    }
  },
  "rewards": {
    "function": "bswt:mob_adjustment/zombie/hit_player"
  }
}

function bswt:mob_adjustment/zombie/hit_player:
    advancement revoke @s only temp:mob/zombie/hit_player
    on attacker if entity @s[type=#minecraft:zombies]:
      effect give @s minecraft:slowness 5 1 true
      scoreboard players set @s ZombieChaseTime 0
      attribute @s minecraft:movement_speed base set 0.24

function bswt:mob_adjustment/zombie/tick:
    scoreboard players add @s ZombieChaseTime 1
    for i in range (60):
      move_speed = (240+(i*5))/1000
      if score @s ZombieChaseTime matches (i) run return run attribute @s minecraft:movement_speed base set (move_speed)
