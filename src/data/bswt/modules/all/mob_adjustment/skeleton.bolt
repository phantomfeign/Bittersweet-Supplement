function bswt:mob_adjustment/skeleton/spawn:
    function utility:clear_armor
    attribute @s minecraft:follow_range base set 256
    attribute @s minecraft:max_health base set 16
    data merge entity @s {Health:16.0f}
    execute store result score #contestedRoll MobEquipmentTier run random value 0..10
    execute if score @s MobEquipmentTier >= #contestedRoll MobEquipmentTier run function bswt:mob_adjustments/individual_mobs/skeleton/variant

function bswt:mob_adjustment/skeleton/variant:
    if predicate bswt:chance/40 run return:
        item replace entity @s armor.head with minecraft:leather_helmet
        item replace entity @s weapon.mainhand with minecraft:wooden_axe
        attribute @s minecraft:attack_damage base set -2
        attribute @s minecraft:max_health base set 20
        data merge entity @s {Health:20.0f}

    tag @s add bswt.spawnForbidden
    execute if predicate bswt:chance/33 run return run summon minecraft:stray
    execute if predicate bswt:chance/50 run return run summon minecraft:parched
    summon minecraft:bogged


