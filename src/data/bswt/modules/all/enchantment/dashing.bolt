enchantment bswt:dashing {
	"description": {
		"translate": "enchantment.bswt.dashing"
	},
	"supported_items": "#minecraft:enchantable/chest_armor",
	"primary_items": "#minecraft:enchantable/chest_armor",
	"weight": 2,
	"max_level": 1,
	"max_cost": {
		"base": 0,
		"per_level_above_first": 0
	},
	"min_cost": {
		"base": 0,
		"per_level_above_first": 0
	},
	"anvil_cost": 0,
	"slots": [
		"chest"
	],
	"effects": {
		"minecraft:tick": [
			{
				"effect": {
					"type": "minecraft:run_function",
					"function": "bswt:enchantment/dashing/check"
				}
			},
			{
				"requirements": {
					"condition": "minecraft:entity_properties",
					"entity": "this",
					"predicate": {
						"minecraft:type_specific/player": {
							"input": {
								"sneak": true
							}
						},
						"minecraft:entity_tags":{"all_of":["canDash"]},
						"flags": {
							"is_sneaking": true,
							"is_on_ground": false,
							"is_in_water": false
						}
					}
				},
				"effect": {
					"type": "minecraft:all_of",
					"effects": [
						{
							"type": "minecraft:run_function",
							"function": "utility:tp"
						},
						{
							"type": "minecraft:apply_impulse",
							"direction": [
								0,
								0.5,
								2
							],
							"coordinate_scale": [
								1,
								0.25,
								1
							],
							"magnitude": 0.5
						},
						{
							"type": "minecraft:run_function",
							"function": "bswt:enchantment/dashing/dash"
						}
					]
				}
			}
		]
	}
}
function bswt:enchantment/dashing/check:
    if predicate bswt:flag/on_ground:
        tag @s add dashEligible
        tag @s remove sneaked
        tag @s remove releasedSneak
        tag @s remove canDash
    execute as @s[tag=dashEligible] unless predicate bswt:player/input/sneak run tag @s add releasedSneak
    execute as @s[tag=releasedSneak] if predicate bswt:player/input/sneak: 
        tag @s add canDash
        tag @s remove releasedSneak

function bswt:enchantment/dashing/dash:
    execute unless score @s dashingDashTimer matches 2.. run return fail
    tag @s remove canDash
    tag @s remove dashEligible
    scoreboard players set @s dashingDashTimer 0
    particle minecraft:cloud ~ ~ ~ 0 0 0 0.05 3 force @a
    playsound minecraft:entity.phantom.flap player @s ~ ~ ~ 4 2
    playsound minecraft:entity.player.attack.nodamage player @s ~ ~ ~ 4 0.3
