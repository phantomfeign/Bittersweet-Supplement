enchantment bswt:hooking {
  "anvil_cost": 0,
  "description": {
    "translate": "enchantment.bswt.hooking"
  },
  "effects": {
    "minecraft:knockback": [
      {
        "effect": {
          "type": "minecraft:add",
          "value": -5
        }
      }
    ],
    "minecraft:post_attack": [
      {
        "effect": {
          "type": "minecraft:all_of",
          "effects": [
            {
              "type": "minecraft:play_sound",
              "pitch": 2,
              "sound": [
                "minecraft:item.spear.lunge_1"
              ],
              "volume": 1
            }
          ]
        },
        "enchanted": "attacker",
        "affected": "attacker"
      },
      {
        "effect": {
          "type": "minecraft:run_function",
          "function": "bswt:enchantment/hooking/pull"
        },
        "enchanted": "attacker",
        "affected": "victim"
      }
    ]
  },
  "max_cost": {
    "base": 0,
    "per_level_above_first": 0
  },
  "max_level": 1,
  "min_cost": {
    "base": 0,
    "per_level_above_first": 0
  },
  "slots": [
    "mainhand"
  ],
  "supported_items": "#minecraft:hoes",
  "weight": 5
}
function bswt:enchantment/hooking/pull:
    #get attacker pos
    execute on attacker store result score #target_x bswt.Math run data get entity @s Pos[0] 1000
    execute on attacker store result score #target_y bswt.Math run data get entity @s Pos[1] 1000
    execute on attacker store result score #target_z bswt.Math run data get entity @s Pos[2] 1000

    #get victim pos
    execute store result score #my_x bswt.Math run data get entity @s Pos[0] 1000
    execute store result score #my_y bswt.Math run data get entity @s Pos[1] 1000
    execute store result score #my_z bswt.Math run data get entity @s Pos[2] 1000
    
    #distance set
    scoreboard players operation #target_x bswt.Math -= #my_x bswt.Math
    scoreboard players operation #target_y bswt.Math -= #my_y bswt.Math
    scoreboard players operation #target_z bswt.Math -= #my_z bswt.Math

    #divide by 1000ish
    execute store result storage bswt:hook.pull MotionX double 0.0004 run scoreboard players get #target_x bswt.Math
    execute store result storage bswt:hook.pull MotionY double 0.0003 run scoreboard players get #target_y bswt.Math
    execute store result storage bswt:hook.pull MotionZ double 0.0004 run scoreboard players get #target_z bswt.Math

    #use macro
    with storage bswt:hook.pull:
        $data modify entity @s Motion set value [$(MotionX),$(MotionY),$(MotionZ)]

    #sound
    playsound minecraft:item.spear.lunge_1 player @a ~ ~ ~ 1 2

    ride @s dismount
    function bswt:mob_effect/cannot_attack/apply {duration:7}

