enchantment bswt:hooking {
  "anvil_cost": 0,
  "description": {
    "translate": "enchantment.bswt.hooking"
  },
  "effects": {
    "minecraft:knockback": [
      {
        "effect": {
          "type": "minecraft:add",
          "value": -5
        }
      }
    ],
    "minecraft:post_attack": [
      {
        "effect": {
          "type": "minecraft:run_function",
          "function": "bswt:enchantment/hooking/pull"
        },
        "enchanted": "attacker",
        "affected": "victim"
      }
    ]
  },
  "max_cost": {
    "base": 0,
    "per_level_above_first": 0
  },
  "max_level": 1,
  "min_cost": {
    "base": 0,
    "per_level_above_first": 0
  },
  "slots": [
    "mainhand"
  ],
  "supported_items": "#minecraft:hoes",
  "weight": 1
}

function bswt:enchantment/hooking/pull:
    #sound
    playsound minecraft:item.spear.lunge_1 player @a ~ ~ ~ 1 2

    ride @s dismount
    function bswt:mob_effect/cannot_attack/apply {duration:7}

    as @s[type=player] run return run function bswt:enchantment/hooking/pull/player

    #get attacker pos
    for plane, pos in [("x", 0), ("y", 1), ("z", 2)]:
        on attacker store result score f"#attacker_{plane}" bswt.Math run data get entity @s f"Pos[{pos}]" 1000

    #get victim pos
    for plane, pos in [("x", 0), ("y", 1), ("z", 2)]:
        store result score f"#victim_{plane}" bswt.Math run data get entity @s f"Pos[{pos}]" 1000
    
    #distance set
    for plane in ["x","y","z"]:
        scoreboard players operation f"#attacker_{plane}" bswt.Math -= f"#victim_{plane}" bswt.Math

    #normalize
    store result storage bswt:hook.pull MotionX double 0.0004 run scoreboard players get #attacker_x bswt.Math
    store result storage bswt:hook.pull MotionY double 0.0003 run scoreboard players get #attacker_y bswt.Math
    store result storage bswt:hook.pull MotionZ double 0.0004 run scoreboard players get #attacker_z bswt.Math

    #set vel
    with storage bswt:hook.pull:
        $data modify entity @s Motion set value [$(MotionX),$(MotionY),$(MotionZ)]

function bswt:enchantment/hooking/pull/player:
    #get attacker pos
    for plane, pos in [("x", 0), ("y", 1), ("z", 2)]:
        on attacker store result score f"${plane}" player_motion.api.launch run data get entity @s f"Pos[{pos}]" 15000

    #get victim pos
    for plane, pos in [("x", 0), ("y", 1), ("z", 2)]:
        store result score f"#victim_{plane}" bswt.Math run data get entity @s f"Pos[{pos}]" 15000

    #distance set
    for plane in ["x","y","z"]:
        scoreboard players operation f"${plane}" player_motion.api.launch -= f"#victim_{plane}" bswt.Math
  
    function player_motion:api/launch_xyz