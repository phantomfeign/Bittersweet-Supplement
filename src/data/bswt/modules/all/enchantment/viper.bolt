					{
						"condition": "minecraft:entity_properties",
						"entity": "this",
						"predicate": {
							"minecraft:entity_tags": {
								"all_of": [
									"bswt.viperOrigin"
								]
							}
						}
					},
					{
						"condition": "minecraft:any_of",
						"terms": [
							{
								"condition": "minecraft:entity_properties",
								"entity": "this",
								"predicate": {
									"minecraft:flags": {
										"is_in_water": true
									}
								}
							},
							{
								"condition": "minecraft:entity_properties",
								"entity": "this",
								"predicate": {
									"minecraft:flags": {
										"is_fall_flying": true
									}
								}
							}
						]
					}
				],
				"effect": {
					"type": "minecraft:all_of",
					"effects": [
						{
							"type": "minecraft:run_function",
							"function": "utility:tp"
