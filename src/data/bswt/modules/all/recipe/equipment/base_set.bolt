    COMPONENTS={
            "minecraft:tooltip_display": {"hidden_components": ["minecraft:attribute_modifiers"]},	
            "minecraft:attribute_modifiers": [
                {
                    "type": "minecraft:attack_damage",
                    "id": f"bswt:{tool['base_tier']}_sword",
                    "amount": weapon_damage-1,
                    "operation": "add_value",
                    "slot": "mainhand"
                },
                {
                    "type": "minecraft:attack_speed",
                    "id": f"bswt:{tool['base_tier']}_sword",
                    "amount": -(4-attack_speed),
                    "operation": "add_value",
                    "slot": "mainhand"
                }
            ],
            "minecraft:lore": [
                {
                    "text": f"{weapon_damage}🗡",
                    "color": "red",
                    "italic": false
                },
                {
                    "text": f"{attack_speed}⌚",
                    "color": "yellow",
                    "italic": false
                }
            ],
            "minecraft:max_damage": max_durability,
        }
    ctx.data.recipes[f"bswt:equipment/crafted/{tool['base_tier']}/sword"] = Recipe({

        "type": "minecraft:crafting_shaped",
        "category": "equipment",
        "pattern": EQUIPMENT_PATTERNS_LOOKUP["sword"]["pattern"],
        "key": {
            "#": "minecraft:stick",
            "X": f"minecraft:{tool["base_item"]}",
        },
        "result": {
            "id": f"minecraft:{tool['base_tier']}_sword",
            "components": COMPONENTS 
        }
    })

