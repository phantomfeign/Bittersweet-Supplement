advancement temp:root {
	"criteria": {
        "impossible": {
			"trigger": "minecraft:impossible"
		}
    }
}

function utility:time_monitor:
  store result score #time Time run time query day
  if score #time Time matches 39000 run function main:sleep/night_start
  if score #time Time matches 2999 run function main:sleep/day_start
  schedule function utility:time_monitor 1t
 
function utility:clear_armor:
  unless predicate bswt:in_trial_chamber run item replace entity @s armor.head with minecraft:air
  unless predicate bswt:in_trial_chamber run item replace entity @s armor.chest with minecraft:air
  unless predicate bswt:in_trial_chamber run item replace entity @s armor.legs with minecraft:air
  unless predicate bswt:in_trial_chamber run item replace entity @s armor.feet with minecraft:air

predicate bswt:in_trial_chamber {
    "condition": "location_check",
    "predicate": {
        "structures": [
            "minecraft:trial_chambers"
        ]
    }
}

function utility:my_tick:
    scoreboard players remove @s bswt.projectileLifeSpan 1
    execute if score @s bswt.projectileLifeSpan matches ..0 run kill @s

function utility:spawn_w_motion:
    #default: /function utility:spawn_w_motion {Type:snowball, X:0,Y:1,Z:6,Tags:loremipsum}

    #spawn the snowball & directional marker
    $execute at @s anchored eyes run summon $(Type) ^ ^ ^ {Tags:["bswt.newProjectile",$(Tags)]}
    $execute at @s anchored eyes run summon marker ^$(X) ^$(Y) ^$(Z) {Tags:["bswt.projectileTarget"]}

    #store marker position as int
    execute as @e[sort=nearest,limit=1,tag=bswt.projectileTarget]: 
      store result score #target_x bswt.Math run data get entity @s Pos[0] 1000
      store result score #target_y bswt.Math run data get entity @s Pos[1] 1000
      store result score #target_z bswt.Math run data get entity @s Pos[2] 1000
      kill @s

    execute as @e[sort=nearest,limit=1,tag=bswt.newProjectile]:
    #store snowball position as int
      store result score #my_x bswt.Math run data get entity @s Pos[0] 1000
      store result score #my_y bswt.Math run data get entity @s Pos[1] 1000
      store result score #my_z bswt.Math run data get entity @s Pos[2] 1000
    
    #math!!
      scoreboard players operation #target_x bswt.Math -= #my_x bswt.Math
      scoreboard players operation #target_y bswt.Math -= #my_y bswt.Math
      scoreboard players operation #target_z bswt.Math -= #my_z bswt.Math

    #return to double
      store result entity @s Motion[0] double 0.0001 run scoreboard players get #target_x bswt.Math
      store result entity @s Motion[1] double 0.0001 run scoreboard players get #target_y bswt.Math
      store result entity @s Motion[2] double 0.0001 run scoreboard players get #target_z bswt.Math
      tag @s remove bswt.newProjectile

function utility:get_motion_towards:
    #default: /function utility:get_motion_towards {force:1,target:"type=player"}

      as @e[sort=nearest,limit=1,$(target)]: 
        store result score #target_x bswt.Math run data get entity @s Pos[0] 1000
        store result score #target_y bswt.Math run data get entity @s Pos[1] 1000
        store result score #target_z bswt.Math run data get entity @s Pos[2] 1000

      store result score #my_x bswt.Math run data get entity @s Pos[0] 1000
      store result score #my_y bswt.Math run data get entity @s Pos[1] 1000
      store result score #my_z bswt.Math run data get entity @s Pos[2] 1000
    
      scoreboard players operation #target_x bswt.Math -= #my_x bswt.Math
      scoreboard players operation #target_y bswt.Math -= #my_y bswt.Math
      scoreboard players operation #target_z bswt.Math -= #my_z bswt.Math

      store result entity @s Motion[0] double 0.000$(force) run scoreboard players get #target_x bswt.Math
      store result entity @s Motion[1] double 0.000$(force) run scoreboard players get #target_y bswt.Math
      store result entity @s Motion[2] double 0.000$(force) run scoreboard players get #target_z bswt.Math

function utility:spawn_damage_dummy:
    summon minecraft:skeleton ~ ~ ~ {Health:100f,Tags:["bswt.damageDummy","bswt.filterBypass"],attributes:[{id:"minecraft:max_health",base:100.0},{id:"minecraft:movement_speed",base:0.0}],equipment:{head:{id:"minecraft:carved_pumpkin"}},NoAI:true}
    execute as @e[type=minecraft:skeleton,tag=bswt.damageDummy] at @s:
        function utility:round_position

function utility:round_position:
    execute align xz run tp @s ~0.5 ~ ~0.5

function utility:ghost_arrow/add:
    tag @s add bswt.ghostArrow
    item replace entity @s saddle with minecraft:arrow[minecraft:equippable={slot:"saddle",equip_sound:"minecraft:intentionally_empty"}]

function utility:ghost_arrow/remove:
    tag @s remove bswt.ghostArrow
    item replace entity @s saddle with minecraft:air

function utility:ghost_arrow/check_overload:
    if items entity @s inventory.* minecraft:arrow run return fail
    if items entity @s hotbar.* minecraft:arrow run return fail

    if items entity @s inventory.* minecraft:stray_spawn_egg run return run function utility:ghost_arrow/add
    if items entity @s hotbar.* minecraft:stray_spawn_egg run return run function utility:ghost_arrow/add

function utility:ghost_arrow/check_infinity:
    if items entity @s inventory.* minecraft:arrow run return fail
    if items entity @s hotbar.* minecraft:arrow run return fail
    function utility:ghost_arrow/add

item_modifier utility:load_arrow {
  "function": "minecraft:set_components",
  "components": {
    "minecraft:charged_projectiles": [
      {
        "id": "minecraft:arrow"
      }
    ]
  }
}
item_modifier utility:load_intangible_arrow {
  "function": "minecraft:set_components",
  "components": {
    "minecraft:charged_projectiles": [
      {
        "id": "minecraft:arrow",
        "components": {
          "minecraft:intangible_projectile": {}
        }
      }
    ]
  }
}

function utility:damage_item/call:
    #e.g. function utility:damage_item/call {heal:0,dmg:1,hand_slot:SelectedItem,damaged_slot:weapon.mainhand}
    data remove storage bswt.durability Item
    scoreboard players set #damage bswt.Math 0

    $data modify storage bswt.durability Item set from entity @s $(hand_slot)
    $data modify storage bswt.durability damaged_slot set value $(damaged_slot)

    if data storage bswt.durability Item.components."minecraft:damage" run \
    store result score #damage bswt.Math run data get storage bswt.durability Item.components."minecraft:damage"

    $scoreboard players add #damage bswt.Math $(dmg)
    $scoreboard players remove #damage bswt.Math $(heal)
    if score #damage bswt.Math matches ..0 run scoreboard players set #damage bswt.Math 0

    scoreboard players set #max_durability bswt.Math 1
    execute store result score #max_durability bswt.Math run data get storage bswt.durability Item.components."minecraft:max_damage"

    $execute unless items entity @s $(damaged_slot) *[custom_data~{bswt.unbreakable:true}] if score #max_durability bswt.Math matches 1.. if score #damage bswt.Math >= #max_durability bswt.Math run playsound minecraft:entity.item.break player @a ~ ~ ~ 4
    $execute unless items entity @s $(damaged_slot) *[custom_data~{bswt.unbreakable:true}] if score #max_durability bswt.Math matches 1.. if score #damage bswt.Math >= #max_durability bswt.Math run return run item replace entity @s $(damaged_slot) with minecraft:air

    store result storage bswt.durability damage int 1 run scoreboard players get #damage bswt.Math
    with storage bswt.durability:
        $item modify entity @s $(damaged_slot) {function:"minecraft:set_components",components:{"minecraft:damage":$(damage)}}

function utility:tp:
    tp @s ~ ~ ~
