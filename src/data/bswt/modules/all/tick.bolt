#—————————————————— 1 TICK
function ticking_functions:tick_1t/call:
    schedule function ticking_functions:tick_1t/call 1t replace
    as @e at @s:
        function ticking_functions:tick_1t/universal
        if entity @s[type=player] run function ticking_functions:tick_1t/players
        
function ticking_functions:tick_1t/players:
    if predicate bswt:enchantment/infinity unless items entity @s saddle minecraft:arrow run function utility:ghost_arrow/check_infinity
    if predicate bswt:enchantment/overload unless items entity @s saddle minecraft:arrow run function utility:ghost_arrow/check_overload
    unless predicate bswt:enchantment/infinity unless predicate bswt:enchantment/overload if items entity @s saddle minecraft:arrow run function utility:ghost_arrow/remove

    execute if predicate bswt:enchantment/hefty run function utility:swap_hands

function ticking_functions:tick_1t/universal:
    as @s[type=arrow,tag=bswt.FastArrow] run function bswt:enchantment/sharpshooter/arrow_tick
    as @s[tag=bswt.cannotAttack] run function utility:weakness_tick
    as @s[type=!#bswt:cant_transfer_fire,predicate=bittersweet_functions:is_on_fire] at @s run function bswt:mob_effect/fire/apply
    as @e[tag=bswt.iceStatue,nbt=!{Health:100.0f}] at @s run function bswt:mob_effect/frostbite/ice_statue/shatter

#—————————————————— 1 SECOND
function ticking_functions:tick_1s/call:
    schedule function ticking_functions:tick_1s/call 1s replace
    as @e at @s:
        function ticking_functions:tick_1s/universal
        if entity @s[type=player] run function ticking_functions:tick_1s/players
        

function ticking_functions:tick_1s/players:
    execute if score @s bswt.Hunger matches 10.. run effect give @s minecraft:hunger 1 255 true
    execute if score @s bswt.Hunger matches ..6: 
        effect give @s minecraft:saturation 1 1 true
        effect clear @s minecraft:hunger
    function utility:anvil/tick
    function bswt:main/adrenaline/tick

function ticking_functions:tick_1s/universal:
    as @s[tag=bswt.lacerated] run function bswt:enchantment/laceration/tick
    as @s[tag=bswt.timed_projectile] run function utility:projectile_tick
    as @s[tag=bswt.OnFire] at @s run function bswt:mob_effect/fire/tick

#—————————————————— 0.5 SECOND
function ticking_functions:tick_0.5s/call:
    schedule function ticking_functions:tick_0.5s/call 10t replace
    as @e at @s:
        function ticking_functions:tick_0.5s/universal
        if entity @s[type=player] run function ticking_functions:tick_0.5s/players
        

function ticking_functions:tick_0.5s/players:
    pass

function ticking_functions:tick_0.5s/universal:
    as @s[tag=bswt.frostbitten] at @s run function bswt:mob_effect/frostbite/tick
