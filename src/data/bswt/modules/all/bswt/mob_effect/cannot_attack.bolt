function bswt:mob_effect/cant_attack/tick:
    scoreboard players remove @s bswt.CantAttack 1
    if score @s bswt.CantAttack matches ..0:
        scoreboard players set @s bswt.CantAttack 0
        effect clear @s minecraft:weakness
        tag @s remove bswt.CantAttack

function bswt:mob_effect/cant_attack/apply:
    #function bswt:mob_effect/cant_attack/apply {duration:20}
    $scoreboard players set @s bswt.CantAttack $(duration)
    effect give @s minecraft:weakness infinite 255 true
    tag @s add bswt.CantAttack
