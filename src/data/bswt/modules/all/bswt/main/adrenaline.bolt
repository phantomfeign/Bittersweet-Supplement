advancement temp:adrenaline/kill {
	"criteria": {
		"kill": {
			"conditions": {
				"killing_blow": {
					"is_direct": true
				},
				"entity": {
					"entity_type": "#bswt.hostiles"
				}
			},
			"trigger": "minecraft:player_killed_entity"
		}
	},
	"rewards": {
		"function": "bswt:main/adrenaline/kill"
	}
}
advancement temp:adrenaline/hurt {
	"criteria": {
		"kill": {
			"trigger": "minecraft:entity_hurt_player"
		}
	},
	"rewards": {
		"function": "bswt:main/adrenaline/hurt"
	}
}
function bswt:main/adrenaline/hurt:
    advancement revoke @s only temp:adrenaline/hurt

    scoreboard players add @s bswt.Adrenaline 2
    as @s[tag=bswt.Rampage] run scoreboard players add @s bswt.Adrenaline 1
    execute store result score #contestedRoll Adrenaline run random value 0..1000
    if score @s bswt.Adrenaline <= #contestedRoll Adrenaline run effect give @s minecraft:regeneration 1 2 true

function bswt:main/adrenaline/kill:
    advancement revoke @s only temp:adrenaline/kill

    scoreboard players add @s bswt.Adrenaline 5
    as @s[tag=bswt.Rampage] run scoreboard players add @s bswt.Adrenaline 5

    as @s[tag=bswt.Rampage] run return run effect give @s minecraft:regeneration 4 0 true

    execute store result score #contestedRoll Adrenaline run random value 0..100
    if score @s bswt.Adrenaline <= #contestedRoll Adrenaline run return fail

    effect give @s minecraft:regeneration 1 2 true
    effect give @s minecraft:regeneration 4 0 true

function bswt:main/adrenaline/tick:
    as @s[tag=!bswt.Rampage] if score @s bswt.Adrenaline matches 100..  run function bswt:main/adrenaline/rampage/start

    as @s[tag=bswt.Rampage] run return run function bswt:main/adrenaline/rampage/tick

    if entity @e[type=#bswt.hostiles,distance=..5] run return run scoreboard players add @s bswt.Adrenaline 1
    if entity @e[type=#bswt.hostiles,distance=..10] run return fail
    if score @s bswt.Adrenaline matches ..10 run return run scoreboard players set @s bswt.Adrenaline 10
    scoreboard players operation @s bswt.Adrenaline *= #90 bswt.Math
    scoreboard players operation @s bswt.Adrenaline /= #100 bswt.Math

function bswt:main/adrenaline/rampage/start:
    tag @s add bswt.Rampage
    effect give @s minecraft:regeneration 3 2 true
    for i in range (8):
        X=(i+1)/4
        playsound entity.warden.heartbeat player @a ~ ~ ~ 10 (X)
    playsound block.creaking_heart.idle player @a ~ ~ ~ 10 2
    playsound block.creaking_heart.idle player @a ~ ~ ~ 10 1
    playsound block.creaking_heart.idle player @a ~ ~ ~ 10 0.5


    playsound minecraft:block.trial_spawner.ominous_activate player @a ~ ~ ~ 10 0.8
    playsound minecraft:block.trial_spawner.about_to_spawn_item player @a ~ ~ ~ 10 2

    particle minecraft:raid_omen ~ ~ ~ 0.2 1 0.2 0 5
    particle minecraft:trial_spawner_detection ~ ~ ~ 0.2 1 0.2 0.1 10

function bswt:main/adrenaline/rampage/tick:
    scoreboard players remove @s bswt.Adrenaline 10

    playsound minecraft:block.copper_bulb.turn_off player @s ~ ~ ~ 1 1

    effect give @s minecraft:strength 2 0 true
    effect give @s minecraft:resistance 2 0 true

    if score @s bswt.Adrenaline matches 1.. run return:
        particle minecraft:raid_omen ~ ~ ~ 0.2 1 0.2 0 4
        particle minecraft:trial_spawner_detection ~ ~ ~ 0.2 1 0.2 0.1 4

    scoreboard players set @s bswt.Adrenaline 0
    tag @s remove bswt.Rampage

    particle minecraft:trial_omen ~ ~ ~ 0.2 1 0.2 0 5
    particle minecraft:trial_spawner_detection_ominous ~ ~ ~ 0.2 1 0.2 0.1 5
    playsound minecraft:entity.wither.spawn player @a ~ ~ ~ 10 2
    playsound minecraft:block.conduit.attack.target player @a ~ ~ ~ 10 1