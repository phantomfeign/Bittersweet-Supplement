function main:weapon/throw/fire_charge/summon:
    advancement revoke @s only main:weapon/throw/fire_charge/summon
    function utility:spawn_w_motion {Type:fireball, X:0,Y:0,Z:6,Tags:timedProjectile}
    as @e[sort=nearest,limit=1,type=minecraft:fireball,tag=timedProjectile]:
        data merge entity @s {ExplosionPower:1}
        scoreboard players set @s bswt.projectileLifeSpan 20
    