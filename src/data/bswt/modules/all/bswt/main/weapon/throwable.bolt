function main:weapon/throw/breeze_rod/summon:
    advancement revoke @s only main:weapon/throw/breeze_rod/summon
    function utility:spawn_w_motion {Type:breeze_wind_charge, X:0,Y:0,Z:6,Tags:timedProjectile}
    as @e[sort=nearest,limit=1,type=minecraft:breeze_wind_charge,tag=timedProjectile] run scoreboard players set @s bswt.projectileLifeSpan 20

advancement main:weapon/throw/fire_charge/summon {
