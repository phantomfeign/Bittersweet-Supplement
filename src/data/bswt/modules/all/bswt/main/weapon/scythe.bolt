function main:weapon/scythe/harvest/call:
    unless score @s bswt.cd.Harvest matches 0 run return fail
    scoreboard players set @s bswt.cd.Harvest 1
    for i in [1.5,0.8,0.5]:
        playsound minecraft:item.spear.lunge_1 player @a ~ ~ ~ 3 (i)
    $function utility:damage_item/call {heal:0,dmg:1,hand_slot:$(hand_slot),damaged_slot:$(damaged_slot)}
    for z in range(1, 3):
        for x in range(-1, 2):
            at @s rotated ~ 0 positioned ^x ^ ^z run function main:weapon/scythe/harvest/single

function main:weapon/scythe/harvest/single:
    if block ~ ~ ~ farmland:
        if block ~ ~1 ~ wheat[age=7] run setblock ~ ~1 ~ wheat[age=1] destroy
        if block ~ ~1 ~ carrots[age=7] run setblock ~ ~1 ~ carrots[age=1] destroy
        if block ~ ~1 ~ beetroots[age=3] run setblock ~ ~1 ~ beetroots[age=1] destroy
        if block ~ ~1 ~ potatoes[age=7] run setblock ~ ~1 ~ potatoes[age=1] destroy
