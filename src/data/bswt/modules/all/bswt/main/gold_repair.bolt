function main:gold_repair/check_damage:
    tag @s add this
    function utility:round_position
    store result score #damage bswt.goldRepair run data get entity @e[type=item,tag=this,limit=1] Item.components."minecraft:damage"
    if score #damage bswt.goldRepair matches 0 run return 0
    at @s as @s run function main:gold_repair/check_gold

function main:gold_repair/check_gold:
    #mark the nearest player as the player performing the repair(this is a special tool to help us later), then check for gold around the item
    as @p[distance=..5] run tag @s add RepairPlayer
    as @e[type=item,distance=..1,] if items entity @s contents minecraft:gold_ingot run function main:gold_repair/repair
    tag @s remove this

function main:gold_repair/repair:
    #special tool!
    particle minecraft:glow ~ ~0.25 ~ 0 0 0 0.05 3
    particle minecraft:firefly ~ ~0.25 ~ 0 1 0 1 3
    playsound entity.experience_orb.pickup player @a ~ ~ ~ 3 1 1
    as @a[tag=RepairPlayer] run advancement grant @s only bswt:progression/worth_its_weight

    store result score #damage bswt.goldRepair run data get entity @e[limit=1,sort=nearest,type=item,tag=this] Item.components."minecraft:damage"
    if score #damage bswt.goldRepair matches 0 run return 0
    scoreboard players remove #damage bswt.goldRepair 100
    if score #damage bswt.goldRepair matches ..-1 run scoreboard players set #damage bswt.goldRepair 0
    store result entity @e[limit=1,sort=nearest,type=item,tag=this] Item.components."minecraft:damage" int 1 run scoreboard players get #damage bswt.goldRepair
    store result score #gold_count bswt.goldRepair run data get entity @s Item.count
    scoreboard players remove #gold_count bswt.goldRepair 1
    if score #gold_count bswt.goldRepair matches 1.. run store result entity @s Item.count int 1 run scoreboard players get #gold_count bswt.goldRepair
    if score #gold_count bswt.goldRepair matches 0 run kill @s

item_tag bswt:equipment/gold_gear {
  "values": [
    "minecraft:golden_helmet",
    "minecraft:golden_chestplate",
    "minecraft:golden_leggings",
    "minecraft:golden_boots",
    "minecraft:golden_sword",
    "minecraft:golden_pickaxe",
    "minecraft:golden_axe",
    "minecraft:golden_shovel",
    "minecraft:golden_hoe"
  ]
}