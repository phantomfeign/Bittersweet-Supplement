advancement main:modify_items/process/stack/snowball {
	"parent": "temp:root",
	"criteria": {
		"get": {
			"trigger": "minecraft:inventory_changed",
			"conditions": {
				"items": [
					{
						"items": "minecraft:snowball",
						"components": {
							"minecraft:max_stack_size": 16
						}
					}
				]
			}
		}
	},
	"rewards": {
		"function": "main:modify_items/process/stack/snowball"
	}
}

function main:modify_items/process/stack/snowball:
    advancement revoke @s only main:modify_items/process/stack/snowball
    clear @s minecraft:snowball[!max_stack_size=64] 1
    give @s minecraft:snowball[max_stack_size=64]
