advancement main:right_click/use {
	"parent": "temp:root",
	"criteria": {
		"right_clicked": {
			"trigger": "minecraft:using_item",
			"conditions": {
				"item": {
					"predicates": {
						"minecraft:custom_data": {
							"bswt.right_click": true
						}
					}
				}
			}
		}
	},
	"rewards": {
		"function": "main:right_click/sort"
	}
}

function main:right_click/sort:
    advancement revoke @s only main:right_click/use
    at @s:
        if predicate main:right_click/mainhand run function main:right_click/call {hand_slot:SelectedItem,damaged_slot:weapon.mainhand}
        unless predicate main:right_click/mainhand if predicate main:right_click/offhand run function main:right_click/call {hand_slot:equipment.offhand,damaged_slot:weapon.offhand}

function main:right_click/call:
    $execute if items entity @s $(damaged_slot) mace unless predicate bswt:player/input/sneak run function main:weapon/mace/wind_charge/summon
    $execute if items entity @s $(damaged_slot) mace if predicate bswt:player/input/sneak run function main:weapon/mace/mine/start {hand_slot:$(hand_slot),damaged_slot:$(damaged_slot)}
    $execute if items entity @s $(damaged_slot) *[minecraft:enchantments~[{enchantments:"bswt:frostbite",levels:1}]] run function bswt:enchantment/frostbite/stomp/start
    $execute if items entity @s $(damaged_slot) *[custom_data~{bswt.crystalline_candle:true}] run function main:weapon/crystalline_candle/use {hand_slot:$(hand_slot),damaged_slot:$(damaged_slot)}
    $execute if items entity @s $(damaged_slot) *[custom_data~{bswt.harvester:true}] run function main:weapon/scythe/harvest/call {hand_slot:$(hand_slot),damaged_slot:$(damaged_slot)}
    function main:actionbar/build/call

predicate main:right_click/mainhand {
    "condition": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "slots": {
            "weapon.mainhand": {
                "predicates": {
                    "minecraft:custom_data": {
                        "bswt.right_click": true
                    }}}}}} 
predicate main:right_click/offhand {
    "condition": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "slots": {
            "weapon.offhand": {
                "predicates": {
                    "minecraft:custom_data": {
                        "bswt.right_click": true
                    }}}}}} 
