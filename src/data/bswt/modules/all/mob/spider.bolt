function bswt:mob/spider/spawn:
    attribute @s minecraft:max_health base set 10
    data merge entity @s {Health:10.0f}
    attribute @s minecraft:movement_speed base set 0.35
    attribute @s minecraft:fall_damage_multiplier base set 0
    attribute @s minecraft:jump_strength base set 0.5

advancement temp:mob/spider/hit_player{
  "parent":"temp:root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:entity_hurt_player",
      "conditions": {
        "damage": {
          "type": {
            "direct_entity": {
              "minecraft:entity_type": "minecraft:spider"
            }
          }
        }
      }
    }
  },
  "rewards": {
    "function": "bswt:mob/spider/hit_player"
  }
}

function bswt:mob/spider/hit_player:
    advancement revoke @s only temp:mob/spider/hit_player

    if block ~ ~ ~ minecraft:cobweb run return fail
    if block ~ ~ ~ minecraft:cobweb run return fail

    unless block ~ ~ ~ minecraft:cobweb run if predicate bswt:chance/20 run fill ~ ~ ~ ~ ~ ~ minecraft:cobweb replace #minecraft:air
    unless block ~ ~1 ~ minecraft:cobweb run if predicate bswt:chance/20 run fill ~ ~1 ~ ~ ~1 ~ minecraft:cobweb replace #minecraft:air


    

    