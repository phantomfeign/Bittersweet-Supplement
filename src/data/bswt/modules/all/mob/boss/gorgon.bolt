loot_table bswt:entity/boss/gorgon {

}

function bswt:mob/boss/gorgon/spawn/start:
    summon armor_stand ~ ~-3.5 ~ {NoGravity:1b,Invulnerable:1b,Invisible:1b,Tags:["spawning"]}
    scoreboard players set @e[type=armor_stand,distance=..4,tag=spawning,limit=1] spawning 100
    playsound minecraft:block.grass.break player @a ~ ~ ~ 1 1
    particle block{block_state:"minecraft:hay_block"} ~ ~ ~ 0 0 0 0 20 normal
    kill @s

function bswt:mob/boss/gorgon/spawn/fx:
    if score @s spawning matches 80 run particle block{block_state:"minecraft:hay_block"} ~ ~1 ~ 0 0 0 0 20 normal
    if score @s spawning matches 80 run playsound minecraft:block.grass.break player @a ~ ~ ~ 1 1
    if score @s spawning matches 60 run particle block{block_state:"minecraft:hay_block"} ~0.5 ~2 ~ 0 0 0 0 30 normal
    if score @s spawning matches 60 run playsound minecraft:block.grass.break player @a ~ ~ ~ 1 1
    if score @s spawning matches 40 run particle block{block_state:"minecraft:hay_block"} ~ ~1 ~0.5 0 0 0 0 30 normal
    if score @s spawning matches 40 run playsound minecraft:block.grass.break player @a ~ ~ ~ 1 1
    if score @s spawning matches 20 run particle block{block_state:"minecraft:hay_block"} ~0.1 ~2 ~0.2 0 0 0 0 30 normal
    if score @s spawning matches 20 run playsound minecraft:block.grass.break player @a ~ ~ ~ 1 1
    if score @s spawning matches 1 run function bswt:mob/boss/gorgon/spawn/summon


function bswt:mob/boss/gorgon/spawn/summon:
    if entity @e[type=skeleton,tag=bswt.Gorgon] run return run\
    tellraw @a {"text":"This monstrosity recoils in the Elysian air.","color":"#ff8f1e"}

    summon skeleton ~ ~1 ~ {\
        drop_chances:{mainhand:0,offhand:0,head:0,chest:0,legs:0,feet:0},
        Tags:["bswt.Gorgon","bswt.filterBypass"],\
        DeathLootTable:"bswt:entity/boss/gorgon",\
        PersistenceRequired:1b,\
        CanPickUpLoot:0b,\
        attributes:[\
            {id:"minecraft:knockback_resistance",base:0.9},\
            {id:"minecraft:step_height",base:1,},\
            {id:"minecraft:movement_efficiency",base:1},\
            {id:"minecraft:oxygen_bonus",base:1023},\
            {id:"minecraft:water_movement_efficiency",base:1},\
            {id:"minecraft:max_health",base:500}],\
        Health:500f,\
        CustomName:{"color":"gold","italic":false,"text":"gorgon"},\
        equipment:{\
            chest:{id:"minecraft:leather_chestplate",components:{"minecraft:dyed_color":8923947}},\
            legs:{id:"minecraft:leather_leggings",components:{"minecraft:dyed_color":8923947}},\
            feet:{id:"minecraft:leather_boots",components:{"minecraft:dyed_color":6044160}}}}\

    as @e[type=skeleton,tag=bswt.Gorgon,limit=1,sort=nearest]:
        scoreboard players set @s ability_timer 400

function bswt:mob/boss/gorgon/tick:
    if block ~ ~ ~ lava run effect give @s fire_resistance 1
function bswt:mob/boss/gorgon/attack/roar:
    playsound minecraft:entity.enderman.scream player @a ~ ~ ~ 1 0.7
    effect give @s slowness 1 9 true
    tp @s ~ ~ ~ facing ~ ~1 ~
    data merge entity @s {NoAI:1b}
    particle cloud ~ ~1.5 ~ 0 0 0 1 16

    as @e[type=player,distance=..5] at @s:
        damage @s 4 minecraft:magic by @e[type=skeleton,tag=bswt.Gorgon,sort=nearest,limit=1]
        for debuff in ["slowness,weakness,mining_fatigue"]:
            effect give @s (debuff) 1 3 true
            effect give @s (debuff) 2 2 true
            effect give @s (debuff) 3 1 true
            effect give @s (debuff) 6 0 true

advancement bswt:mob/boss/gorgon/hit_player {
  "parent": "temp:root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:entity_hurt_player",
      "conditions": {
        "damage": {
          "type": {
            "tags": [
              {
                "id": "harvester",
                "expected": false
              }
            ],
            "source_entity": {
              "minecraft:entity_type": "minecraft:skeleton"
            }
          }
        }
      }
    }
  },
  "rewards": {
    "function": "bswt:mob/boss/gorgon/hit_player"
  }
}
advancement bswt:mob/boss/gorgon/kill_player {
  "criteria": {
    "kill": {
      "trigger": "minecraft:entity_killed_player",
      "conditions": {
        "killing_blow": {
          "tags": [
            {
              "id": "harvester",
              "expected": false
            }
          ],
          "is_direct": true
        }
      }
    }
  },
  "rewards": {
    "function": "bswt:mob/boss/gorgon/kill_player"
  }
}
    
function bswt:mob/boss/gorgon/hit_player:
    advancement revoke @s only bswt:mob/boss/gorgon/hit_player
    for i in range (4):
        severity=i
        duration=5/(i+1)
        effect give @s poison (duration) (severity) 

function bswt:mob/boss/gorgon/kill_player
    advancement revoke @s only bswt:mob/boss/gorgon/kill_player
    for i in range (4):
        severity=i
        duration=5/(i+1)
        effect give @s poison (duration) (severity) 

