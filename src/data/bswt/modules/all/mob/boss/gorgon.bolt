loot_table bswt:entity/boss/gorgon {

}

function bswt:mob/boss/gorgon/spawn/start:
    summon armor_stand ~ ~-3.5 ~ {NoGravity:1b,Invulnerable:1b,Invisible:1b,Tags:["spawning"]}
    scoreboard players set @e[type=armor_stand,distance=..4,tag=spawning,limit=1] spawning 100
    playsound minecraft:block.grass.break player @a ~ ~ ~ 1 1
    particle block{block_state:"minecraft:hay_block"} ~ ~ ~ 0 0 0 0 20 normal
    kill @s

function bswt:mob/boss/gorgon/spawn/fx:
    if score @s spawning matches 80 run particle block{block_state:"minecraft:hay_block"} ~ ~1 ~ 0 0 0 0 20 normal
    if score @s spawning matches 80 run playsound minecraft:block.grass.break player @a ~ ~ ~ 1 1
    if score @s spawning matches 60 run particle block{block_state:"minecraft:hay_block"} ~0.5 ~2 ~ 0 0 0 0 30 normal
    if score @s spawning matches 60 run playsound minecraft:block.grass.break player @a ~ ~ ~ 1 1
    if score @s spawning matches 40 run particle block{block_state:"minecraft:hay_block"} ~ ~1 ~0.5 0 0 0 0 30 normal
    if score @s spawning matches 40 run playsound minecraft:block.grass.break player @a ~ ~ ~ 1 1
    if score @s spawning matches 20 run particle block{block_state:"minecraft:hay_block"} ~0.1 ~2 ~0.2 0 0 0 0 30 normal
    if score @s spawning matches 20 run playsound minecraft:block.grass.break player @a ~ ~ ~ 1 1
    if score @s spawning matches 1 run function bswt:mob/boss/gorgon/spawn/summon

function bswt:mob/boss/gorgon/spawn/kill:
    kill @e[limit=1,sort=nearest,type=skeleton,tag=bswt.Gorgon]

function bswt:mob/boss/gorgon/spawn/summon:
    if entity @e[type=skeleton,tag=bswt.Gorgon] run return run \
    tellraw @a {"text":"This monstrosity recoils in the Elysian air.","color":"#ff8f1e"}

    summon skeleton ~ ~1 ~ {\
        drop_chances:{mainhand:0,offhand:0,head:0,chest:0,legs:0,feet:0},
        Tags:["bswt.Gorgon","bswt.adjustmentBypass","bswt.filterBypass"],\
        CustomName:{"color":2975253,"italic":false,"text":"Gorgon"},\
        DeathLootTable:"bswt:entity/boss/gorgon",\
        PersistenceRequired:1b,\
        CanPickUpLoot:0b,\
        Silent:1b,\
        Health:500f,\
        attributes:[\
            {id:"minecraft:max_health",base:500},\
            {id:"minecraft:follow_range",base:50},\
            {id:"minecraft:scale",base:1.1},\
            {id:"minecraft:knockback_resistance",base:0.9},\
            {id:"minecraft:step_height",base:1,},\
            {id:"minecraft:movement_efficiency",base:1},\
            {id:"minecraft:oxygen_bonus",base:1023},\
            {id:"minecraft:water_movement_efficiency",base:1}],\
        equipment:{\
            head:{id:"minecraft:carved_pumpkin"},\
            chest:{id:"minecraft:leather_chestplate",components:{"minecraft:dyed_color":2975253}},\
            legs:{id:"minecraft:leather_leggings",components:{"minecraft:dyed_color":2975253}},\
            feet:{id:"minecraft:leather_boots",components:{"minecraft:dyed_color":4599559}}}}\

    as @e[limit=1,type=skeleton,tag=bswt.Gorgon]:
        scoreboard players set @s bswt.bossAbilityTimer 0

function bswt:mob/boss/gorgon/tick:
    if block ~ ~ ~ lava run effect give @s fire_resistance 1
    scoreboard players add @s bswt.bossAbilityTimer 1
    if score @s bswt.bossAbilityTimer matches 10 run function bswt:mob/boss/gorgon/attack/call

function bswt:mob/boss/gorgon/attack/call:
    store result score @s bswt.bossAbilityTimer run random value 1..2
    if score @s bswt.bossAbilityTimer matches 1 run function bswt:mob/boss/gorgon/attack/screech
    if score @s bswt.bossAbilityTimer matches 2 run function bswt:mob/boss/gorgon/attack/lunge/windup
    scoreboard players set @s bswt.bossAbilityTimer 0

function bswt:mob/boss/gorgon/attack/screech:
    unless entity @a[distance=8..128] run return run function bswt:mob/boss/gorgon/attack/call
    function bswt:mob_effect/noai/apply {duration:15}
    rotate @s ~ -60

    particle minecraft:sonic_boom ~ ~2 ~ 0 0 0 0 1 force
    particle minecraft:gust ~ ~2 ~ 0 0 0 0 1 force
    as @a[distance=..128]:
      for i in [0.1,0.2,0.3]:
        playsound minecraft:entity.fox.screech hostile @s ~ ~ ~ 10 (i)

    for debuff in ["slowness", "weakness", "mining_fatigue"]:
        as @a[distance=8..128]:
            for i in range(7):
                dist = 8 + (i * 16)
                duration = 5 + ((i)*2)
                severity = round(-0.2 * (i + 1) / 7, 4)
                if entity @s[distance=(dist)..128]:
                    effect give @s (debuff) (duration) (i)
                    function bswt:mob_effect/jump_weakness/apply {duration:(duration),severity:(severity)}

function bswt:mob/boss/gorgon/attack/lunge/windup:
    rotate @s ~45 20
    function bswt:mob_effect/noai/apply {duration:14}
    item replace entity @s weapon.mainhand with minecraft:iron_spear
    schedule function bswt:mob/boss/gorgon/attack/lunge/execute 15t
    as @e[limit=1] at @s run playsound minecraft:entity.player.attack.sweep hostile @a ~ ~ ~ 1 1

function bswt:mob/boss/gorgon/attack/lunge/execute:
    schedule function bswt:mob/boss/gorgon/attack/lunge/cleanup 15t
    as @e[limit=1,type=skeleton,tag=bswt.Gorgon]:
      as @e[limit=1] at @s run playsound minecraft:item.spear.lunge_1 hostile @a ~ ~ ~ 1 0.8
      at @p rotate @s facing ~ ~0.5 ~
      function utility:get_motion_towards {force:1,target:"type=player"}
      effect give @s slowness 2 1
function bswt:mob/boss/gorgon/attack/lunge/cleanup:
    as @e[limit=1,type=skeleton,tag=bswt.Gorgon]:
      item replace entity @s weapon.mainhand with minecraft:air

advancement bswt:mob/boss/gorgon/kill_player {
  "criteria": {
    "kill": {
      "trigger": "minecraft:entity_killed_player",
      "conditions": {
        "killing_blow": {
          "tags": [
            {
              "id": "bswt.Gorgon",
              "expected": false
            }
          ],
          "is_direct": true
        }
      }
    }
  },
  "rewards": {
    "function": "bswt:mob/boss/gorgon/kill_player"
  }
}
    
function bswt:mob/boss/gorgon/hit_player:
    advancement revoke @s only bswt:mob/boss/gorgon/hit_player
    for i in range (4):
        severity=i
        duration=5-(i+1)
        effect give @s poison (duration) (severity)

function bswt:mob/boss/gorgon/kill_player:
    advancement revoke @s only bswt:mob/boss/gorgon/kill_player

