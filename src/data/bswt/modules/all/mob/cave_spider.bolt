function bswt:mob/cave_spider/spawn:
  attribute @s minecraft:max_health base set 8
  data merge entity @s {Health:8.0f}
  attribute @s minecraft:movement_speed base set 0.35
  attribute @s minecraft:attack_damage base set 1
  attribute @s minecraft:fall_damage_multiplier base set 0
  attribute @s minecraft:jump_strength base set 0.5

advancement temp:mob/cave_spider/hit_player{
  "parent":"temp:root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:entity_hurt_player",
      "conditions": {
        "damage": {
          "type": {
            "direct_entity": {
              "minecraft:entity_type": "minecraft:cave_spider"
            }
          }
        }
      }
    }
  },
  "rewards": {
    "function": "bswt:mob/cave_spider/hit_player"
  }
}

function bswt:mob/cave_spider/hit_player:
    advancement revoke @s only temp:mob/cave_spider/hit_player
    effect give @s minecraft:poison 2 5    

    