function bswt:mob/phantom/spawn:
    attribute @s minecraft:max_health base set 40
    data merge entity @s {Health:40.0f,PersistenceRequired:1b}
    attribute @s minecraft:scale base set 1.25
    attribute @s minecraft:attack_damage base set 8
    attribute @s minecraft:knockback_resistance base set 1
    effect give @s glowing infinite

advancement temp:mob/phantom/kill_player {
  "criteria": {
    "kill": {
      "trigger": "minecraft:entity_killed_player",
      "conditions": {
        "killing_blow": {
          "source_entity": {
            "minecraft:entity_type": "minecraft:phantom"
          },
          "is_direct": true
        }
      }
    }
  },
  "rewards": {
    "function": "bswt:mob/phantom/kill_player"
  }
}
function bswt:mob/phantom/kill_player:
    as @e[limit=1,sort=nearest,type=minecraft:phantom] run data merge entity @s {Health:40.0f}


advancement temp:mob/phantom/hit_player {
  "parent": "temp:root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:entity_hurt_player",
      "conditions": {
        "damage": {
          "type": {
            "source_entity": {
              "minecraft:entity_type": "minecraft:phantom"
            }
          }
        }
      }
    }
  },
  "rewards": {
    "function": "bswt:mob/phantom/hit_player"
  }
}

function bswt:mob/phantom/hit_player:
    effect give @s minecraft:slowness 5
    effect give @s minecraft:levitation 3