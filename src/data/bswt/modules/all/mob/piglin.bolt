function bswt:mob/piglin/spawn:
    if items entity @s weapon.mainhand minecraft:crossbow run item modify entity @s weapon.mainhand bswt:mob/piglin_crossbow

item_modifier bswt:mob/piglin_crossbow {
    "function": "minecraft:set_components",
    "components": {
      "minecraft:enchantments": {"minecraft:quick_charge": 1},
      "minecraft:enchantment_glint_override": false,
      "minecraft:item_model": "bswt_texture:gilded_crossbow",
      "minecraft:custom_data": {
        "bswt.piglinCrossbow": true
    }
  }
}

