def generate_slab(block):
    recipe_json = {
        "type": "minecraft:crafting_shaped",
        "pattern": [
            "##"
        ],
        "key": {
            "#": {"item": f"minecraft:{block}"},
        },
        "result": {
            "id": f"minecraft:{block}_slab",
            "count": 1
        }
    }
    ctx.data.recipes[f"{block}_slab"] = recipe_json

materials = {"cobblestone"}
for item in materials.items():
    generate_recipe(item)
