function ticking_functions:call_all:
    schedule function ticking_functions:tick_1t/call 1t replace
    schedule function ticking_functions:tick_0.25s/call 6t replace
    schedule function ticking_functions:tick_0.5s/call 11t replace
    schedule function ticking_functions:tick_1s/call 23t replace
    schedule function ticking_functions:tick_2s/call 47t replace
    schedule function ticking_functions:tick_10s/call 203t replace
    schedule function utility:time_monitor 2t replace

#—————————————————— 1 TICK
function ticking_functions:tick_1t/call:
    schedule function ticking_functions:tick_1t/call 1t replace
    function ticking_functions:tick_1t/universal
    as @a at @s run function ticking_functions:tick_1t/players

function ticking_functions:tick_1t/universal:
    as @e[type=minecraft:arrow,tag=bswt.FastArrow] run function bswt:enchantment/sharpshooter/arrow_tick
    as @e[type=minecraft:arrow] at @s if block ~ ~ ~ minecraft:pointed_dripstone[vertical_direction=down] if predicate bswt:flag/arrow_in_ground run setblock ~ ~ ~ air destroy
    
    as @e[type=fishing_bobber,tag=bswt.grapplerBobber,tag=!bswt.grappler.init] at @s positioned ~ ~-1.62 ~ run function main:grappler/uuid/bobber
    as @e[type=fishing_bobber,tag=bswt.grapplerBobber,tag=!bswt.grappler.hooked] at @s if predicate bswt:flag/on_ground run function main:grappler/hook

    as @e[type=#bswt:living_mobs,predicate=bswt:mob_effect/is_on_fire] run function bswt:mob_effect/fire/apply

    as @e[type=#bswt:hostiles, tag=bswt.jumpWeakness] run function bswt:mob_effect/jump_weakness/tick
    as @e[type=#bswt:hostiles, tag=bswt.cantAttack] run function bswt:mob_effect/cant_attack/tick
    as @e[type=#bswt:hostiles, tag=bswt.noAI] run function bswt:mob_effect/noai/tick
    as @e[type=#bswt:hostiles, tag=bswt.spearing] run function bswt:mob_effect/spearing/tick

    as @e[type=block_display,tag=bswt.vinerySpore] run function bswt:enchantment/vinery/petal/tick
    
    as @e[type=area_effect_cloud,tag=!bswt.aec_checked] run function bswt:mob/area_effect_cloud/spawn
    as @e[type=marker,tag=bswt.frostbiteStompMarker] run function bswt:enchantment/frostbite/stomp/tick
    as @e[type=marker,tag=bswt.crystalline_candle_proj] run function main:weapon/crystalline_candle/projectile/tick

    if score #title bswt.bossAbilityTimer matches 1.. as @e[type=skeleton,tag=bswt.Gorgon] at @s run function bswt:mob/boss/gorgon/title/tick
    as @e[type=marker,tag=bswt.GorgonWatcher] unless entity @e[type=skeleton,tag=bswt.Gorgon] run function bswt:mob/boss/gorgon/bossbar/clear

    as @e[type=armor_stand,tag=bswt.GorgonRockMount] at @s run function bswt:mob/boss/gorgon/attack/throw_rock/tick
    as @e[type=#main:minecart/boost_eligible] at @s run function main:minecart/boost

function ticking_functions:tick_1t/players:
    if entity @s[tag=bswt.holdingCrucifix]:
        scoreboard players remove @s bswt.usingCrucifix 1
        if score @s bswt.usingCrucifix matches ..0 run function main:spirit/crucifix/holding/clear
    function bswt:mob/creeper/watch/tick
    if predicate main:climbing/blocks run function main:climb
    if predicate bswt:enchantment/infinity unless items entity @s saddle minecraft:arrow run function utility:ghost_arrow/check_infinity
    if predicate bswt:enchantment/overload unless items entity @s saddle minecraft:arrow run function utility:ghost_arrow/check_overload
    unless predicate bswt:enchantment/infinity unless predicate bswt:enchantment/overload if items entity @s saddle minecraft:arrow run function utility:ghost_arrow/remove
    if predicate bswt:enchantment/hefty run function utility:swap_hands
    if entity @s[scores={bswt.playerDeaths=1..}] run function bswt:main/health/death
    #sleep
    tag @s add bswt.sleeping
    positioned ~ ~0.200001 ~ if entity @s[dx=0] run tag @s remove bswt.sleeping
    if entity @s[tag=bswt.sleeping]:
        unless score #sleep SleepAttempt matches 1 run schedule function main:sleep/advance_time 40t replace
        scoreboard players set #sleep SleepAttempt 1

#—————————————————— 0.25 SECOND
function ticking_functions:tick_0.25s/call:
    schedule function ticking_functions:tick_0.25s/call 5t replace
    function ticking_functions:tick_0.25s/universal
    as @a at @s run function ticking_functions:tick_0.25s/players
        
function ticking_functions:tick_0.25s/universal:
    kill @e[type=experience_orb]
    as @e[type=marker,tag=bswt.crystalline_candle_proj] run function main:weapon/crystalline_candle/projectile/fx
    function main:spirit/crucifix/tick

function ticking_functions:tick_0.25s/players:
    if score @s bswt.Hunger matches 10.. run effect give @s minecraft:hunger 1 255 true
    if score @s bswt.Hunger matches ..7: 
        effect give @s minecraft:saturation 1 1 true
        effect clear @s minecraft:hunger


#—————————————————— 0.5 SECOND
function ticking_functions:tick_0.5s/call:
    schedule function ticking_functions:tick_0.5s/call 10t replace
    function ticking_functions:tick_0.5s/universal
    as @a at @s run function ticking_functions:tick_0.5s/players
        
function ticking_functions:tick_0.5s/universal:
    as @e[type=#bswt:living_mobs,tag=bswt.frostbitten] run function bswt:mob_effect/frostbite/tick
    as @e[type=#bswt:hostiles, tag=bswt.iceStatue,nbt=!{Health:100.0f}] run function bswt:mob_effect/frostbite/ice_statue/shatter
    as @e[type=enderman] at @s run function bswt:mob/enderman/tick

function ticking_functions:tick_0.5s/players:
    if entity @s[tag=bswt.Cramped] if block ~ ~2 ~ #bswt:nonsolid run tag @s remove bswt.Cramped
    if entity @s[tag=!bswt.Cramped] unless block ~ ~2 ~ #bswt:nonsolid run tag @s add bswt.Cramped

#—————————————————— 1 SECOND
function ticking_functions:tick_1s/call:
    schedule function ticking_functions:tick_1s/call 1s replace
    function ticking_functions:tick_1s/universal
    as @a at @s run function ticking_functions:tick_1s/players
        
function ticking_functions:tick_1s/universal:
    as @e[type=#bswt:living_mobs,tag=bswt.lacerated] run function bswt:enchantment/laceration/tick
    as @e[type=#minecraft:impact_projectiles,tag=bswt.timed_projectile] run function utility:projectile_tick
    as @e[type=#bswt:living_mobs,tag=bswt.OnFire] run function bswt:mob_effect/fire/tick
    as @e[type=#bswt:living_mobs,tag=bswt.Petrified] run function bswt:mob_effect/petrified/tick
    as @e[type=#bswt:spawn_check,tag=!bswt.spawnChecked] run function bswt:mob/universal/filter
    as @e[type=zombie] if predicate bswt:mob/has_target if entity @a[distance=..64] run function bswt:mob/zombie/tick
    as @e[type=minecraft:marker,tag=spawner_marker] at @s run function main:spawner/marker/tick
    as @e[type=item] if items entity @s contents #bswt:equipment/gold_gear at @s run function main:gold_repair/check_damage
    unless score #title bswt.bossAbilityTimer matches 1.. as @e[type=skeleton,tag=bswt.Gorgon] at @s run function bswt:mob/boss/gorgon/tick

function ticking_functions:tick_1s/players:
    function utility:anvil/tick
    function bswt:main/adrenaline/tick
    function ticking_functions:tick_1s/cooldowns
    function main:actionbar/build/call
    function main:spawner/replace_spawners 
    if items entity @s container.* *[minecraft:custom_data~{bswt.crystalline_candle:true}] run function main:weapon/crystalline_candle/heal
    if predicate bswt:enchantment/verdure/light run function bswt:enchantment/verdure/tick
    if entity @s[tag=bswt.vineryCaster] unless entity @e[type=minecraft:block_display,tag=bswt.vinerySpore,distance=..20] run tag @s remove bswt.vineryCaster

function ticking_functions:tick_1s/cooldowns:
    for cooldown in [
    "Lunge",
    "Gust",
    "Mine",
    "FrostbiteStomp",
    "Harvest"
    ]:
        SCORE=f"bswt.cd.{cooldown}"
        unless score @s (SCORE) matches ..0 run scoreboard players remove @s (SCORE) 1
        if score @s (SCORE) matches ..-1 run scoreboard players set @s (SCORE) 0
    #special
    if entity @s[tag=!canLunge] if score @s bswt.cd.Lunge matches ..0 run tag @s add canLunge

#—————————————————— 2s
function ticking_functions:tick_2s/call:
    schedule function ticking_functions:tick_2s/call 2s replace
    function ticking_functions:tick_2s/universal
    as @a at @s run function ticking_functions:tick_2s/players
        
function ticking_functions:tick_2s/universal:
    pass

function ticking_functions:tick_2s/players:
    if predicate main:player/has_regen run function main:rose_gold/tick

#—————————————————— 10s
function ticking_functions:tick_10s/call:
    schedule function ticking_functions:tick_10s/call 10s replace
    function ticking_functions:tick_10s/universal
    as @a at @s run function ticking_functions:tick_10s/players
        
function ticking_functions:tick_10s/universal:
    as @e[tag=bswt.spawnForbidden] run function utility:delete_self

function ticking_functions:tick_10s/players:
    function bswt:main/campfire/tick