from beet import ItemTag
STACK = [
    "snowball",
    "egg",
    "brown_egg",
    "blue_egg",
    "milk_bucket"
]
REPLACE = [
    "fire_charge",
    "breeze_rod",
    "blaze_rod",
    "brown_mushroom",
    "red_mushroom",
    "tropical_fish",
    "honey_bottle",
]
ctx.data.item_tags["main:modify_items/stack_list"] = ItemTag ({
    "values": (STACK)
})
ctx.data.item_tags["main:modify_items/replace_list"] = ItemTag ({
    "values": (REPLACE)
})

function main:modify_items/process/replace:
    for entry in ["fire_charge","breeze_rod","blaze_rod","tropical_fish"]:
        item=f"{entry}[!custom_data={{adjusted_item:1b}}]"
        replacement=f"bswt:misc/{entry}"
        if items entity @s container.* (item):
            loot give @s loot (replacement)
            clear @s (item) 1
    for entry in ["brown_mushroom","red_mushroom","honey_bottle"]:
        item=f"{entry}[!custom_data={{adjusted_item:1b}}]"
        replacement=f"bswt:food/{entry}"
        if items entity @s container.* (item):
            loot give @s loot (replacement)
            clear @s (item) 1
    #retrigger
    if items entity @s container.* #main:modify_items/replace_list[!custom_data={adjusted_item:1b}] run function main:modify_items/process/replace

advancement main:modify_items/check {
    "parent": "temp:root",
	"criteria": {
		"inventory_changed": {
			"trigger": "minecraft:inventory_changed",
			"conditions": {}
		}
	},
	"rewards": {
		"function": "main:modify_items/check"
	}
}

function main:modify_items/check:
    advancement revoke @s only main:modify_items/check
    execute if entity @s[tag=bswt.modifyingItems] run return fail
    tag @s add bswt.modifyingItems

    if items entity @s container.* #main:modify_items/replace_list[!custom_data={adjusted_item:1b}] run function main:modify_items/process/replace

    if items entity @s container.* #main:modify_items/stack_list run function main:modify_items/process/stack

    if items entity @s container.* minecraft:potion[potion_contents={potion:"minecraft:water"},!max_stack_size=64] run function main:modify_items/process/water

    if items entity @s container.* minecraft:arrow[minecraft:equippable={slot:"saddle"}] run function main:modify_items/process/arrow

    tag @s remove bswt.modifyingItems

function main:modify_items/process/water:
    #water
    if items entity @s container.* minecraft:potion[potion_contents={potion:"minecraft:water"},!max_stack_size=64] run give @s minecraft:potion[max_stack_size=64,minecraft:custom_name={"text":"Vial of Water","italic":false},potion_contents={potion:"minecraft:water"}]
    
    if items entity @s container.* minecraft:potion[potion_contents={potion:"minecraft:water"},!max_stack_size=64] run clear @s minecraft:potion[potion_contents={potion:"minecraft:water"},!max_stack_size=64] 1

function main:modify_items/process/arrow:
    if items entity @s container.* minecraft:arrow[minecraft:equippable={slot:"saddle"}] run give @s minecraft:arrow
    if items entity @s container.* minecraft:arrow[minecraft:equippable={slot:"saddle"}] run clear @s minecraft:arrow[minecraft:equippable={slot:"saddle"}] 1

    if items entity @s container.* minecraft:arrow[minecraft:equippable={slot:"saddle"}] run return run function main:modify_items/process/arrow

advancement main:modify_items/process/stack/snowball {
	"parent": "temp:root",
	"criteria": {
		"get": {
			"trigger": "minecraft:inventory_changed",
			"conditions": {
				"items": [
					{
						"items": "minecraft:snowball",
						"components": {
							"minecraft:max_stack_size": 16
						}
					}
				]
			}
		}
	},
	"rewards": {
		"function": "main:modify_items/process/stack/snowball"
	}
}

function main:modify_items/process/stack/snowball:
    advancement revoke @s only main:modify_items/process/stack/snowball
    clear @s minecraft:snowball[!max_stack_size=64] 1
    give @s minecraft:snowball[max_stack_size=64]
