function bswt:mob/area_effect_cloud/spawn:
    as @e[type=area_effect_cloud,nbt={potion_contents:{custom_effects:[{id:"minecraft:luck",amplifier:99b}]}}] at @s:
        function bswt:mob/area_effect_cloud/creeper_explosion
    tag @s add bswt.aec_checked

function bswt:mob/area_effect_cloud/creeper_explosion:
    effect clear @a[distance=..8] minecraft:luck
    effect clear @s minecraft:luck

    #poison
    for i in range(4):
        dist = (i + 1) * 2
        duration = 4 + (i * 2)
        amp = 4 - i
        effect give @a[distance=..(dist)] minecraft:poison (duration) (amp)

    #explosion damage
    for i in range(5):
        min_dist = f"{i}.1"
        max_dist = i + 1
        dmg = 10 - (i * 2)
        as @a[distance=(min_dist)..(max_dist)] run damage @s (dmg) minecraft:explosion

    #heal undead
    execute as @e[distance=0..2] if entity @s[type=#bswt:zombie_variant] run effect give @s minecraft:instant_damage 1 2
    execute as @e[distance=2.1..4] if entity @s[type=#bswt:zombie_variant] run effect give @s minecraft:instant_damage 1 1

    #knockback
    summon breeze_wind_charge ~ ~1 ~ {Motion:[0.0,-5.0,0.0]}
    summon breeze_wind_charge ~ ~ ~ {Motion:[0.0,-5.0,0.0]}

    #play da noize
    playsound minecraft:entity.generic.explode hostile @a ~ ~ ~ 1 0.9
    particle minecraft:noxious_gas ~ ~ ~ 1 0 1 1 20 normal
    particle minecraft:geyser_base{water_blocks:4,burst_impulse_base:1.5} ~ ~ ~ 0 0 0 0 1 normal
    particle minecraft:explosion_emitter ~ ~-0.5 ~

    #gunpowda
    summon item ~ ~ ~ {Item:{id:"minecraft:gunpowder",count:1}}
    kill @s

entity_type_tag bswt:zombie_variant {
        "values": [
            "minecraft:husk",
            "minecraft:zombie",
            "minecraft:drowned"
        ]
    }