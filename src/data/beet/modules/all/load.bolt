append function_tag load {
    "values": [
        "load:load",
        "ticking_functions:call_all"
    ]
} 

function load:load:
    tellraw @a {"text":"Thank you for taking your Bittersweet Supplement!","color":"#c6b3c8"}
    tellraw @a {"text":"Lost? Check the Advancement Menu!","color":"#a990a9"}
    tellraw @a {"text":"Bittersweet Supplement for Java 26.2 by phantomfeign","color":"#87658a"}
    forceload add -1 -1 1 1
    advancement revoke @a through temp:root
    function load:scoreboard
    function load:gamerule

function load:scoreboard:
    function bswt:grappler/load
    scoreboard objectives add bswt.maxHealth dummy
    scoreboard players add @a bswt.maxHealth 0
    execute as @a store result score @s bswt.maxHealth run attribute @s minecraft:max_health get 1.0
    scoreboard objectives add bswt.playerHealth health
    scoreboard objectives add bswt.healthDummy dummy
    
    scoreboard objectives add bswt.damageIndicator dummy
    scoreboard objectives add bswt.totalDamage dummy
    scoreboard objectives add bswt.combatTicks dummy
    scoreboard objectives add bswt.idleTicks dummy
    
    scoreboard objectives add Day dummy
    scoreboard objectives add Time dummy
    scoreboard objectives add SleepAttempt dummy
    scoreboard objectives add SleepStreak dummy
    scoreboard objectives add BloodMoonActive dummy

    scoreboard objectives add bswt.healthRecoveryTime dummy
    scoreboard objectives add bswt.healthRecoverySeconds dummy
    scoreboard objectives add bswt.playerDeaths deathCount

    scoreboard objectives add bswt.timer dummy
    scoreboard objectives add bswt.bossAbilityTimer dummy

    scoreboard objectives add bswt.Math dummy
    for num in [1,3,10,20,70,90,98,100,150,200]:
        scoreboard players set f"#{num}" bswt.Math (num)
    
    scoreboard objectives add bswt.goldRepair dummy
   
    scoreboard objectives add bswt.projectileLifeSpan dummy
    
    scoreboard objectives add bswt.Hunger food
    scoreboard objectives add bswt.Adrenaline dummy
    stopwatch create bswt_anvil_timer
    scoreboard objectives add bswt.anvilUse minecraft.custom:minecraft.interact_with_anvil
    scoreboard players set 0 bswt.anvilUse 0

    scoreboard objectives add bswt.ZombieChaseTimer dummy
    scoreboard objectives add bswt.endermanPullTimer dummy
    scoreboard objectives add bswt.spawnerTimer dummy
    scoreboard objectives add bludgeonedTimer dummy
#———————————————————WEAPONS
#CRYSTALLINE CANDLE
    scoreboard objectives add bswt.crystallineCandle dummy
#CRUCIFIX
    scoreboard objectives add bswt.usingCrucifix dummy
    scoreboard objectives add bswt.crucifixPower dummy

#———————————————————MOB EFFEC
    for timer in [
        "fire",
        "jumpWeakness",
        "noAI",
        "cantAttack",
        "spearing",
        "petrified"
    ]:
        scoreboard objectives add f"bswt.{timer}Timer" dummy
        
#———————————————————ENCHANTS
#LACERATION
    scoreboard objectives add bswt.lacerationStacks dummy
#BOUNDING
    scoreboard objectives add bswt.boundingJumps dummy
    scoreboard objectives add bswt.playerJumps minecraft.custom:minecraft.jump
#SHARPSHOOTER
    scoreboard objectives add bswt.arrowAge dummy
#OVERLOAD
    scoreboard objectives add bswt.arrowCount dummy
#HOOKING
    scoreboard objectives add bswt.weaknessTimer dummy
#FROSTBITE
    scoreboard objectives add bswt.frostbiteTimer dummy
#VIPER
    scoreboard objectives add bswt.viperTimer dummy
#VINERY
    scoreboard objectives add bswt.vineryStacks dummy
    scoreboard players add @a bswt.vineryStacks 0
#COOLDOWNS
    for cooldown in [
    "Lunge",
    "Gust",
    "Mine",
    "FrostbiteStomp",
    "Harvest"
    ]:
        SCORE=f"bswt.cd.{cooldown}"
        scoreboard objectives add (SCORE) dummy
        scoreboard players add @s (SCORE) 0

function load:gamerule:
    gamerule natural_health_regeneration false
    gamerule keep_inventory true
    gamerule advance_time true
    gamerule spawn_phantoms false
    gamerule block_explosion_drop_decay false
    gamerule mob_explosion_drop_decay false
    gamerule ender_pearls_vanish_on_death false
    gamerule command_block_output false

