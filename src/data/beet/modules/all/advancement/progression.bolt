FLINT_PIECES = [
    "sword",
    "pickaxe",
    "axe",
]

FULL_EQUIPMENT_PIECES = [
    "spear",
    "sword",
    "axe",
    "pickaxe",
    "shovel",
    "hoe",
    "helmet",
    "chestplate",
    "leggings",
    "boots",
]

TIER_ADVANCEMENTS = {
    "obtain_flint": {
        "tier": "flint",
        "method": "crafted",
        "pieces": FLINT_PIECES,
        "icon": "minecraft:flint",
        "title": "Flint and.. Sticks?",
        "description": "Make primitive tools.",
        "parent": "root",
    },
    "obtain_copper": {
        "tier": "copper",
        "method": "crafted",
        "pieces": FULL_EQUIPMENT_PIECES,
        "icon": "minecraft:copper_ingot",
        "title": "Liberty, Liberty, Liberty",
        "description": "\"Ey, I'm walkin 'ere!\".",
        "parent": "obtain_furnace",
    },
    "obtain_gold": {
        "tier": "gold",
        "method": "crafted",
        "pieces": FULL_EQUIPMENT_PIECES,
        "icon": "minecraft:gold_ingot",
        "title": "Gold Rush",
        "description": "\"We\"re rich! Rich and gay.\"",
        "parent": "obtain_copper",
    },
    "obtain_iron": {
        "tier": "iron",
        "method": "crafted",
        "pieces": FULL_EQUIPMENT_PIECES,
        "icon": "minecraft:iron_ingot",
        "title": "Hard 2 Break",
        "description": "\"People like you bring me nothing but anger.\"",
        "parent": "obtain_copper",
    },
    "obtain_diamond": {
        "tier": "diamond",
        "method": "smithed",
        "pieces": FULL_EQUIPMENT_PIECES,
        "icon": "minecraft:diamond",
        "title": "Diamond Standard",
        "description": "\"Miiine diamonds.\"",
        "parent": "blast_diamond",
    },
    "obtain_netherite": {
        "tier": "netherite",
        "method": "smithed",
        "pieces": FULL_EQUIPMENT_PIECES,
        "icon": "minecraft:netherite_ingot",
        "title": "Tartarus's Spoils",
        "description": "In with the new..",
        "parent": "blast_debris",
    },
}

for filename, data in TIER_ADVANCEMENTS.items():
    criteria = {}
    for piece in data["pieces"]:
        criteria[piece] = {
            "trigger": "minecraft:recipe_crafted",
            "conditions": {
                "recipe_id": f"bswt:equipment/{data['method']}/{data['tier']}/{piece}"
            },
        }

    advancement f"bswt:progression/{filename}" {
        "display": {
            "icon": {
                "id": data["icon"],
                "components": {}
            },
            "title": data["title"],
            "description": data["description"],
            "frame": "task",
            "show_toast": true,
            "announce_to_chat": true,
            "hidden": false
        },
        "parent": f"bswt:progression/{data['parent']}",
        "criteria": criteria,
        "requirements": [data["pieces"]],
    }
