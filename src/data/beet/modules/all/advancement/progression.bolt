            "trigger": "minecraft:item_used_on_block",
            "conditions": {
                "location": [
                    {
                        "condition": "minecraft:any_of",
                        "terms": [
                            {
                                "condition": "minecraft:block_state_property",
                                "block": "minecraft:lava"
                            },
                            {
                                "condition": "minecraft:block_state_property",
                                "block": "minecraft:lava_cauldron"
                            }
                        ]
                    },
                    {
                        "condition": "minecraft:match_tool",
                        "predicate": {
                            "items": [
                                "minecraft:bucket"
                            ]
                        }
                    }
                ]
            }
        }
    }
}

