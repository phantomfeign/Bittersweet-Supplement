from beet import Advancement

advancement bswt:progression/root {
    "display": {
        "icon": {
            "id": "minecraft:lily_of_the_valley"
        },
        "title": "",
        "description": "",
        "background": "minecraft:block/green_terracotta",
        "frame": "challenge",
        "show_toast": false,
        "announce_to_chat": false,
        "hidden": false
    },
    "criteria": {
        "root": {
            "trigger": "minecraft:tick"
        }
    }
}

ADVANCEMENTS = {
    "obtain_campfire": {
        "title": "It's a Start",
        "description": "Acquire a campfire",
        "item": "campfire",
        "frame": "task",
        "parent": "obtain_flint",
    },
    "obtain_smoker": {
        "title": "Sous Chef",
        "description": "Cooks faster and cooks meat better!",
        "item": "smoker",
        "frame": "goal",
        "parent": "obtain_campfire",
        "rewards": {
            "recipes": [],
            "function": "bswt:food/smoker_recipes_unlock"
        },
    },
    "obtain_empty_boon": {
        "title": "Gifts of Old",
        "description": "What will you do when given a blank slate?",
        "item": "villager_spawn_egg",
        "frame": "task",
        "parent": "obtain_gold",
    },
    "obtain_blast_furnace": {
        "title": "Smelt Harder, Not Smarter",
        "description": "Blast furnaces leave less waste behind.",
        "item": "blast_furnace",
        "frame": "task",
        "parent": "obtain_furnace",
    },
    "obtain_furnace": {
        "title": "Did I Leave The—",
        "description": "Craft a furnace using bricks hardened by campfire smoke.",
        "item": "furnace",
        "frame": "task",
        "parent": "obtain_campfire",
    },
    "obtain_verdum": {
        "title": "Magic Moss",
        "description": "Acquire Verdum Crystals from vine-covered temples or crafting.",
        "item": "bogged_spawn_egg",
        "frame": "goal",
        "parent": "obtain_iron",
    },
}

for filename, data in ADVANCEMENTS.items():
    item_id = f"minecraft:{data['item']}"
    parent_id = f"bswt:progression/{data['parent']}"

    adv_body = {
        "display": {
            "icon": {"id": item_id},
            "title": data["title"],
            "description": data["description"],
            "frame": data["frame"],
            "show_toast": true,
            "announce_to_chat": true,
            "hidden": data.get("hidden", false),
        },
        "parent": parent_id,
        "criteria": {
            "acquire": {
                "trigger": "minecraft:inventory_changed",
                "conditions": {
                    "items": [
                        {"items": [item_id]}
                    ]
                },
            }
        },
    }

    if "rewards" in data:
        adv_body["rewards"] = data["rewards"]

    advancement f"bswt:progression/{filename}" adv_body

