from beet import Recipe
from beet:all/utils/tiers import TIERS, TIER_LOOKUP, EQUIPMENT_PATTERNS_LOOKUP

ARMOR_TYPES = (
    ("helmet", "head"),
    ("chestplate", "chest"),
    ("leggings", "legs"),
    ("boots", "feet"),
)

CUSTOM_NAMES = {
    "diamond": "Diamond",
    "netherite": "Adamantine",
    "rose_gold": "Rose Gold",
    "bronze": "Bronze",
}

NETHERITE_IMMUNITIES = {
    "helmet": "🧪⛨: Blindness",
    "chestplate": "🧪⛨: Weakness",
    "leggings": "🧪⛨: Poison",
    "boots": "🧪⛨: Slowness",
}

CRAFTED_ARMOR_TIERS = {
    "leather": {"item": "leather", "sound": "leather", "major": 3, "minor": 2},
    "copper": {"item": "copper_ingot", "sound": "copper", "major": 4, "minor": 3},
    "chainmail": {"item": "iron_chain", "sound": "chain", "major": 2, "minor": 2},
    "iron": {"item": "iron_ingot", "sound": "iron", "major": 5, "minor": 4},
    "golden": {"item": "gold_ingot", "sound": "gold", "major": 4, "minor": 3},
}

SMITHED_ARMOR_TIERS = {
    "diamond": {"item": "diamond", "sound": "diamond", "major": 4, "minor": 4},
    "netherite": {"item": "netherite_ingot", "sound": "netherite", "major": 5, "minor": 5},
    "rose_gold": {"item": "axolotl_spawn_egg", "sound": "gold", "major": 4, "minor": 4},
    "bronze": {"item": "horse_spawn_egg", "base": "copper", "sound": "copper", "major": 0, "minor": 0},
}


def get_armor_result_id(_base_tier, _armor_type):
    if _base_tier in ("rose_gold", "bronze"):
        return f"minecraft:diamond_{_armor_type}"
    return f"minecraft:{_base_tier}_{_armor_type}"


def build_armor_components(_base_tier, _armor_type, _slot, _config):
    _components = {}

    if _base_tier == "bronze":
        _components = {
            "minecraft:item_name": {
                "text": f"{CUSTOM_NAMES[_base_tier]} {_armor_type.capitalize()}",
                "color": "aqua",
            },
            "minecraft:item_model": f"bswt_texture:bronze_{_armor_type}",
            "minecraft:max_damage": TIERS[4]["durability"],
            "minecraft:tooltip_display": {"hidden_components": ["minecraft:attribute_modifiers"]},
            "minecraft:equippable": {
                "slot": _slot,
                "equip_sound": "minecraft:item.armor.equip_copper",
                "asset_id": "minecraft:bronze",
            },
            "minecraft:attribute_modifiers": [
                {
                    "type": "minecraft:attack_damage",
                    "id": f"bswt:bronze_{_armor_type}",
                    "amount": 2,
                    "operation": "add_value",
                    "slot": _slot,
                },
                {
                    "type": "minecraft:max_health",
                    "id": f"bswt:bronze_{_armor_type}",
                    "amount": -2,
                    "operation": "add_value",
                    "slot": _slot,
                },
            ],
            "minecraft:lore": [
                {
                    "text": "+2🗡",
                    "color": "red",
                    "italic": false,
                },
                {
                    "text": "-1❤",
                    "color": "dark_red",
                    "italic": false,
                },
            ],
        }
        return _components

    _tier = TIER_LOOKUP[_base_tier]
    _armor_points = _config["major"]
    if _armor_type in ("helmet", "boots"):
        _armor_points = _config["minor"]

    _components = {
        "minecraft:max_damage": _tier["durability"],
        "minecraft:tooltip_display": {"hidden_components": ["minecraft:attribute_modifiers"]},
        "minecraft:attribute_modifiers": [
            {
                "type": "minecraft:armor",
                "id": f"bswt:{_base_tier}_{_armor_type}",
                "amount": _armor_points,
                "operation": "add_value",
                "slot": _slot,
            }
        ],
        "minecraft:lore": [
            {
                "text": f"{_armor_points}⛨",
                "color": "blue",
                "italic": false,
            }
        ],
    }

    # custom model and worn texture for rose gold
    if _base_tier == "rose_gold":
        _components["minecraft:item_model"] = f"bswt_texture:rose_gold_{_armor_type}"
        _components["minecraft:equippable"] = {
            "slot": _slot,
            "equip_sound": "minecraft:item.armor.equip_gold",
            "asset_id": "minecraft:rose_gold"
        }
        _components["minecraft:custom_data"] = {
            "bswt.rose_gold":true
        }
        _components["minecraft:lore"].extend([
            {
                "text": "Regenerates when you do.",
                "color": "gray",
                "italic": false,
            }
        ])

    # equippable sound override for helmets
    if _armor_type == "helmet":
        if _base_tier in ("copper", "golden", "diamond", "netherite"):
            _components["minecraft:equippable"] = {
                "slot": "head",
                "equip_sound": f"minecraft:item.armor.equip_{_config['sound']}",
            }

    # chainmail perks
    if _base_tier == "chainmail":
        _components["minecraft:enchantment_glint_override"] = false
        _components["minecraft:enchantments"] = {
            "minecraft:protection": 1,
        }

    # golden set bonus lore
    if _base_tier == "golden":
        _components["minecraft:attribute_modifiers"].append({
            "type": "minecraft:burning_time",
            "id": f"bswt:golden_{_armor_type}_burn_time",
            "amount": -0.125,
            "operation": "add_multiplied_base",
            "slot": _slot,
        })
        _components["minecraft:lore"].append({
            "text": "🔥⛨",
            "color": "gray",
            "italic": False,
        })
        
    # diamond speed bonus
    if _base_tier == "diamond":
        _components["minecraft:attribute_modifiers"].append({
            "type": "minecraft:movement_speed",
            "id": f"bswt:diamond_{_armor_type}",
            "amount": 0.003,
            "operation": "add_value",
            "slot": _slot,
        })
        _components["minecraft:lore"].append({
            "text": "+3% Movespeed",
            "color": "gray",
            "italic": false,
        })

    # netherite speed penalty and potion immunities
    if _base_tier == "netherite":
        _components["minecraft:attribute_modifiers"].append({
            "type": "minecraft:movement_speed",
            "id": f"bswt:netherite_{_armor_type}_slow",
            "amount": -0.005,
            "operation": "add_value",
            "slot": _slot,
        })
        _components["minecraft:lore"].extend([
            {
                "text": "-5% Movespeed",
                "color": "gray",
                "italic": false,
            },
            {
                "text": NETHERITE_IMMUNITIES[_armor_type],
                "color": "gray",
                "italic": false,
            },
        ])

    # custom item names
    if _base_tier in CUSTOM_NAMES:
        _components["minecraft:item_name"] = {
            "text": f"{CUSTOM_NAMES[_base_tier]} {_armor_type.capitalize()}",
            "color": "aqua",
        }

    return _components


def add_crafted_armor(_base_tier, _config, _armor_type, _slot):
    ctx.data.recipes[f"bswt:equipment/crafted/{_base_tier}/{_armor_type}"] = Recipe({
        "type": "minecraft:crafting_shaped",
        "category": "equipment",
        "pattern": EQUIPMENT_PATTERNS_LOOKUP[_armor_type]["pattern"],
        "key": {
            "X": f"minecraft:{_config['item']}",
        },
        "result": {
            "id": get_armor_result_id(_base_tier, _armor_type),
            "components": build_armor_components(_base_tier, _armor_type, _slot, _config),
        },
    })


def add_smithed_armor(_base_tier, _config, _armor_type, _slot):
    _base_material = _config.get("base", "golden")
    ctx.data.recipes[f"bswt:equipment/smithed/{_base_tier}/{_armor_type}"] = Recipe({
        "type": "minecraft:smithing_transform",
        "addition": f"minecraft:{_config['item']}",
        "base": f"minecraft:{_base_material}_{_armor_type}",
        "template": "minecraft:netherite_upgrade_smithing_template",
        "result": {
            "id": get_armor_result_id(_base_tier, _armor_type),
            "components": build_armor_components(_base_tier, _armor_type, _slot, _config),
        },
    })


#——————————— RECIPE GEN

for _tier_name, _tier_cfg in CRAFTED_ARMOR_TIERS.items():
    for _armor_type, _slot in ARMOR_TYPES:
        add_crafted_armor(_tier_name, _tier_cfg, _armor_type, _slot)

for _tier_name, _tier_cfg in SMITHED_ARMOR_TIERS.items():
    for _armor_type, _slot in ARMOR_TYPES:
        add_smithed_armor(_tier_name, _tier_cfg, _armor_type, _slot)
