from beet import Recipe
from beet:all/utils/tiers import TIERS, TIER_LOOKUP, NUMBER_LOOKUP

MULTITOOL_TIERS = [
    {"tier": "diamond", "addition": "emerald", "material": "diamond"},
    {"tier": "netherite", "addition": "emerald", "material": "netherite_ingot"},
    {"tier": "rose_gold", "addition": "emerald", "material": "axolotl_spawn_egg"},
    {"tier": "golden", "base_item": "gold_ingot", "addition": "amethyst_shard"},
    {"tier": "iron", "base_item": "iron_ingot", "addition": "gold_ingot"},
    {"tier": "copper", "base_item": "copper_ingot", "addition": "iron_ingot"},
]

TOOL_CONFIGS = {
    "mattock": {
        "result_base": "shovel",
        "secondary": "pickaxe",
        "pattern": [
            "XXP",
            " #X",
            "# X"
        ],
        "tags": ["#minecraft:mineable/pickaxe", "#minecraft:mineable/shovel"],
        "dmg_mult": 0.6,
        "spd_mult": 0.8
    },
    "pulaski": {
        "result_base": "hoe",
        "secondary": "axe",
        "pattern": [
            "XPX",
            "X# ",
            " # "
        ],
        "tags": ["#minecraft:mineable/axe", "#minecraft:mineable/hoe"],
        "dmg_mult": 0.8,
        "spd_mult": 0.6
    },
}

CUSTOM_NAMES = {
    "diamond": "Diamond",
    "netherite": "Adamantine",
    "rose_gold": "Rose Gold",
}


def make_result(tier, tool_name, cfg):
    stats = TIER_LOOKUP[tier]
    attack_damage = int(stats["weapon_damage"] * cfg["dmg_mult"])
    attack_speed = round(stats["attack_speed"] * cfg["spd_mult"], 1)

    rules = []
    for t in cfg["tags"]:
        rules.append({
            "blocks": t,
            "speed": stats["mining_speed"],
            "correct_for_drops": True
        })

    if tier == "rose_gold":
        result_id = f"minecraft:diamond_{cfg['result_base']}"
    else:
        result_id = f"minecraft:{tier}_{cfg['result_base']}"

    custom_data = {"bswt:multitool": tool_name}
    if tier == "rose_gold":
        custom_data["bswt_rose_gold"] = True

    if tier in CUSTOM_NAMES:
        item_name = {"text": f"{CUSTOM_NAMES[tier]} {tool_name.capitalize()}", "color": "aqua"}
    else:
        item_name = {"translate": f"item.bswt.{tier}_{tool_name}", "italic": false}
    if tier == "rose_gold":
        dmg_color = "#e69cb8"  
    else:
        dmg_color = "red"
    lore = [
        {"text": f"{stats['mining_speed']}⛏", "color": "gold", "italic": false},
        {"text": f"{attack_damage}🗡", "color": dmg_color, "italic": false},
        {"text": f"{attack_speed}⌚", "color": "yellow", "italic": false},
    ]

    components = {
        "minecraft:item_name": item_name,
        "minecraft:item_model": f"bswt_texture:{tier}_{tool_name}",
        "minecraft:custom_data": custom_data,
        "minecraft:tooltip_display": {"hidden_components": ["minecraft:attribute_modifiers"]},
        "minecraft:lore": lore,
        "minecraft:max_damage": int(stats["durability"] * 1.5),
        "minecraft:tool": {
            "rules": rules,
            "default_mining_speed": 1,
            "damage_per_block": 1,
        },
        "minecraft:attribute_modifiers": [
            {
                "type": "minecraft:attack_damage",
                "id": f"bswt:{tier}_{tool_name}",
                "amount": attack_damage - 1,
                "operation": "add_value",
                "slot": "mainhand",
            },
            {
                "type": "minecraft:attack_speed",
                "id": f"bswt:{tier}_{tool_name}",
                "amount": round(-(4 - attack_speed), 1),
                "operation": "add_value",
                "slot": "mainhand",
            },
        ],
    }
    if tier == "rose_gold":
        lore.append(
            {"text": "Lifesteals, and regenerates when you do.", "color": "gray", "italic": false}
        )
        components["minecraft:damage_type"] = "bswt:rose_gold"

    return {
        "id": result_id,
        "components": components,
    }


for entry in MULTITOOL_TIERS:
    tier = entry["tier"]
    for name in TOOL_CONFIGS:
        cfg = TOOL_CONFIGS[name]
        result = make_result(tier, name, cfg)

        # CRAFTING
        if "base_item" in entry:
            ctx.data.recipes[f"bswt:equipment/crafted/{tier}/{name}"] = Recipe({
                "type": "minecraft:crafting_shaped",
                "category": "equipment",
                "pattern": cfg["pattern"],
                "key": {
                    "#": "minecraft:stick",
                    "X": f"minecraft:{entry['base_item']}",
                    "P": f"minecraft:{entry['addition']}",
                },
                "result": result,
            })
        else:
            gold_tools = [
                f"minecraft:golden_{cfg['result_base']}",
                f"minecraft:golden_{cfg['secondary']}",
            ]
            ctx.data.recipes[f"bswt:equipment/smithed/{tier}/{name}"] = Recipe({
                "type": "minecraft:smithing_transform",
                "template": f"minecraft:{entry['addition']}",
                "base": gold_tools,
                "addition": f"minecraft:{entry['material']}",
                "result": result,
            })
