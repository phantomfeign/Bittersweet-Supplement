for name, data in REQUIEM_LIST.items():
    lore_lines = []
    for line in data["lore"]:
        lore_lines.append({"text": line, "color": "#73537c"})

    recipe_body = {
        "category": "misc",
        "result": {
            "id": "minecraft:enchanted_book",
            "components": {
                "minecraft:item_name": {
                    "translate": f"requiem.bswt.{name}",
                    "color": "#87658a",
                },
                "minecraft:item_model": f"bswt_texture:requiem_{name}",
                "minecraft:lore": lore_lines,
                "minecraft:stored_enchantments": data["enchants"],
            },
        },
    }

    if "ingredients" in data:
        recipe_body["type"] = "minecraft:crafting_shapeless"
        recipe_body["ingredients"] = data["ingredients"]

    else:
        recipe_body["type"] = "minecraft:crafting_shaped"
        recipe_body["key"] = {
            "#": "minecraft:villager_spawn_egg",
            **data["key"],
        }
        recipe_body["pattern"] = data["pattern"]

    recipe f"bswt:requiem/{name}" recipe_body
