enchantment bswt:skirmishing {
  "description": {
    "translate": "enchantment.bswt.skirmishing",
    "fallback": "Skirmishing"
  },
  "effects": {
    "minecraft:tick": [
      {
        "effect": {
          "type": "minecraft:run_function",
          "function": "bswt:enchantment/skirmishing/tick"
        }
      }
    ]
  },
  "anvil_cost": 1,
  "max_cost": {
    "base": 1,
    "per_level_above_first": 1
  },
  "max_level": 1,
  "min_cost": {
    "base": 1,
    "per_level_above_first": 1
  },
  "slots": [
    "mainhand"
  ],
  "supported_items": "#minecraft:enchantable/weapon",
  "exclusive_set": "#minecraft:exclusive_set/damage",
  "weight": 10
}
predicate bswt:flag/sprinting {
  "condition": "minecraft:all_of",
  "terms": [
    {
      "condition": "minecraft:entity_properties",
      "entity": "this",
      "predicate": {
        "minecraft:flags": {
          "is_sprinting": false
        }
      }
    }
  ]
}
function bswt:enchantment/skirmishing/tick:
    unless predicate bswt:flag/sprinting run return run attribute @s remove attack_speed bswt.skirmishing
    attribute @s add attack_speed bswt.skirmishing add_value 0.5