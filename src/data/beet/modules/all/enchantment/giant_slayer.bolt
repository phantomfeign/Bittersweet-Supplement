enchantment bswt:giant_slayer {
  "description": {
    "translate": "enchantment.bswt.giant_slayer",
    "fallback": "Giant Slayer"
  },
  "effects": {
    "minecraft:post_attack": [
      {
        "enchanted": "attacker",
        "affected": "victim",
        "effect": {
          "type": "minecraft:run_function",
          "function": "bswt:enchantmentgiant_slayer/hit"
        }
      }
    ]
  },
  "anvil_cost": 1,
  "max_cost": {
    "base": 1,
    "per_level_above_first": 1
  },
  "max_level": 1,
  "min_cost": {
    "base": 1,
    "per_level_above_first": 1
  },
  "slots": [
    "mainhand"
  ],
  "supported_items": "#minecraft:enchantable/weapon",
  "exclusive_set": "#minecraft:exclusive_set/damage",
  "weight": 10
}
function bswt:enchantment/giant_slayer/hit:
    store result score @s bswt.healthDummy run attribute @s minecraft:max_health get 100

    scoreboard players operation @s bswt.healthDummy *= #2 bswt.Math
    scoreboard players operation @s bswt.healthDummy /= #100 bswt.Math

    store result storage bswt.giant_slayer damage float 0.01 run scoreboard players get @s bswt.healthDummy

    with storage bswt.giant_slayer:
        $damage @s $(damage) magic
