enchantment bswt:bow_mechanics {
	"description": {
		"translate": "enchantment.bswt.bow_mechanics"
	},
	"supported_items": [
        "minecraft:bow",
        "minecraft:crossbow"
        ],
	"weight": 1,
	"max_level": 1,
	"min_cost": {
		"base": 0,
		"per_level_above_first": 0
	},
	"max_cost": {
		"base": 0,
		"per_level_above_first": 0
	},
	"anvil_cost": 0,
	"slots": [
		"mainhand"
	],
	"effects": {
		"minecraft:projectile_spawned": [
			{
				"effect": {
					"type": "minecraft:run_function",
					"function": "bswt:enchantment/bow_mechanics/ignite"
				}
			}
		]
	}
}

block_tag bswt:flammable_torches {
  "values": [
    "minecraft:torch",
    "minecraft:wall_torch",
    "minecraft:copper_torch",
    "minecraft:copper_wall_torch",
    "minecraft:soul_torch",
    "minecraft:soul_wall_torch",
  ]
}

function bswt:enchantment/bow_mechanics/ignite:
    tag @s add FlintArrow
    on origin:
		unless items entity @s weapon.offhand minecraft:flint_and_steel unless block ~ ~ ~ #bswt:flammable_torches unless block ~ ~1 ~ #bswt:flammable_torches run return fail
        function utility:damage_item/call {heal:0,dmg:1,hand_slot:SelectedItem,damaged_slot:weapon.mainhand}
        playsound minecraft:item.flintandsteel.use player @a
    as @s run data modify entity @s Fire set value 1000
    particle minecraft:flame ^ ^ ^ 0 0 0 0.2 3
    particle minecraft:item{item:{id:"minecraft:flint"}} ~ ~ ~ 0 0 0 0.1 3
    on origin if items entity @s weapon.offhand minecraft:flint_and_steel[custom_data={firestarter:true}]: 
        playsound minecraft:entity.item.break player @a
        item replace entity @s weapon.offhand with air
