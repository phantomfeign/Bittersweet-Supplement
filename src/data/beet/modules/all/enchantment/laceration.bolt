enchantment sharpness {
	"description": {
		"translate": "enchantment.minecraft.sharpness"
	},
	"effects": {
		"minecraft:post_attack": [
			{
				"enchanted": "attacker",
				"affected": "victim",
				"effect": {
					"type": "minecraft:run_function",
					"function": "bswt:enchantmentlaceration/apply"
				}
			}
		]
	},
	"anvil_cost": 1,
	"max_cost": {
		"base": 1,
		"per_level_above_first": 1
	},
	"max_level": 1,
	"min_cost": {
		"base": 1,
		"per_level_above_first": 1
	},
	"slots": [
		"mainhand"
	],
	"supported_items": "#minecraft:enchantable/sharp_weapon",
	"exclusive_set": "#minecraft:exclusive_set/damage",
	"weight": 10
}
function bswt:enchantment/laceration/apply:
    tag @s add bswt.lacerated
    execute unless score @s bswt.lacerationStacks matches 1.. run scoreboard players add @s bswt.lacerationStacks 1
    scoreboard players add @s bswt.lacerationStacks 1

function bswt:enchantment/laceration/tick:
    execute store result storage bswt.laceration Severity int 1 run scoreboard players get @s bswt.lacerationStacks
    function enchantment:laceration/damage with storage bswt.laceration
    scoreboard players remove @s bswt.lacerationStacks 1
    if score @s bswt.lacerationStacks matches ..0:
        scoreboard players reset @s bswt.lacerationStacks
        tag @s remove bswt.lacerated

function bswt:enchantment/laceration/damage:
    $damage @s $(Severity) minecraft:magic
    particle minecraft:dust{color:[0.8,0,0],scale:1} ~ ~1 ~ 0.5 0.5 0.5 0 2
    $particle minecraft:dust{color:[0.8,0,0],scale:1} ~ ~1 ~ 0.5 0.5 0.5 0 $(Severity)
