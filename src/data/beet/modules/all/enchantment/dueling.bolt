enchantment bswt:dueling {
  "description": {
    "translate": "enchantment.bswt.dueling",
    "fallback": "Dueling"
  },
  "effects": {
    "minecraft:tick": [
      {
        "effect": {
          "type": "minecraft:run_function",
          "function": "bswt:enchantment/dueling/tick"
        }
      }
    ]
  },
  "anvil_cost": 1,
  "max_cost": {
    "base": 1,
    "per_level_above_first": 1
  },
  "max_level": 1,
  "min_cost": {
    "base": 1,
    "per_level_above_first": 1
  },
  "slots": [
    "mainhand"
  ],
  "supported_items": "#minecraft:enchantable/weapon",
  "exclusive_set": "#minecraft:exclusive_set/damage",
  "weight": 10
}
predicate bswt:enchantment/dueling {
  "condition": "minecraft:all_of",
  "terms": [
    {
      "condition": "minecraft:entity_properties",
      "entity": "this",
      "predicate": {
        "minecraft:flags": {
          "is_sprinting": false,
          "is_on_ground": true
        }
      }
    }
  ]
}
function bswt:enchantment/dueling/tick:
    unless predicate bswt:enchantment/dueling run return run attribute @s remove attack_damage bswt.dueling
    attribute @s add attack_damage bswt.dueling add_value 3