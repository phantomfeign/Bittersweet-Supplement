enchantment bane_of_arthropods {
	"description": {
		"translate": "enchantment.minecraft.bane_of_arthropods"
	},
	"effects": {
		"minecraft:tick": [
			{
				"effect": {
					"type": "minecraft:run_function",
					"function": "bswt:enchantment/desperation/tick"
				}
			}
		],
		"minecraft:post_attack": [
			{
				"requirements": {
					"condition": "minecraft:inverted",
					"term": {
						"condition": "minecraft:entity_properties",
						"entity": "this",
						"predicate": {
							"minecraft:entity_type": "#bswt:nonliving_entity"
						}
					}
				},
				"effect": {
					"type": "minecraft:run_function",
					"function": "bswt:enchantment/desperation/heal"
				},
				"enchanted": "attacker",
				"affected": "attacker"
			}
		]
	},
	"anvil_cost": 1,
	"max_cost": {
		"base": 1,
		"per_level_above_first": 1
	},
	"max_level": 1,
	"min_cost": {
		"base": 1,
		"per_level_above_first": 1
	},
	"slots": [
		"mainhand"
	],
	"supported_items": "#minecraft:enchantable/melee_weapon",
	"exclusive_set": "#minecraft:exclusive_set/damage",
	"weight": 10
}
function bswt:enchantment/desperation/tick:
    attribute @s minecraft:attack_speed modifier remove bswt:desperation
    execute as @s[scores={bswt.playerHealth=11..}] run return fail 
    for i in range(5):
        max_hp = 10 - (i * 2)
        min_hp = max_hp - 1
        modifier_value = round(0.2 + (i * 0.2), 1)
        
        if score @s bswt.playerHealth matches f"{min_hp}..{max_hp}" run return run attribute @s minecraft:attack_speed modifier add bswt:desperation f"{modifier_value}" add_value

function bswt:enchantment/desperation/heal:
    execute as @s[scores={bswt.playerHealth=11..}] if predicate bswt:chance/25 run return run effect give @s minecraft:regeneration 2 1 true
    execute as @s[scores={bswt.playerHealth=5..10}] if predicate bswt:chance/50 run return run effect give @s minecraft:regeneration 2 1 true
    execute as @s[scores={bswt.playerHealth=..5}] run return run effect give @s minecraft:regeneration 2 1 true
