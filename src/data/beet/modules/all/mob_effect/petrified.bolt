advancement bswt:mob_effect/petrified/clear {
  "parent": "temp:root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:entity_hurt_player",
      "conditions": {
        "player": {
          "minecraft:entity_tags": {
            "all_of": [
              "bswt.Petrified"
            ]
          }
        },
        "damage": {
          "taken": {
            "min": 1
          }
        }
      }
    }
  },
  "rewards": {
    "function": "bswt:mob_effect/petrified/clear"
  }
}
function bswt:mob_effect/petrified/clear:
    advancement revoke @s only bswt:mob_effect/petrified/clear
    
    attribute @s minecraft:attack_damage modifier remove bswt.petrified
    attribute @s minecraft:movement_speed modifier remove bswt.petrified
    attribute @s minecraft:jump_strength modifier remove bswt.petrified
    attribute @s minecraft:knockback_resistance modifier remove bswt.petrified

    scoreboard players set @s bswt.petrifiedTimer 0
    tag @s remove bswt.Petrified

function bswt:mob_effect/petrified/apply:
    #function bswt:mob_effect/petrified/apply {duration:60}
    $scoreboard players set @s bswt.petrifiedTimer $(duration)

    attribute @s minecraft:attack_damage modifier add bswt.petrified -100 add_value
    attribute @s minecraft:movement_speed modifier add bswt.petrified -100 add_value
    attribute @s minecraft:jump_strength modifier add bswt.petrified -1 add_value
    attribute @s minecraft:knockback_resistance modifier add bswt.petrified 1 add_value
    tag @s add bswt.Petrified

function bswt:mob_effect/petrified/tick:
    scoreboard players remove @s bswt.petrifiedTimer 1
    if score @s bswt.petrifiedTimer matches ..0 run function bswt:mob_effect/petrified/clear

