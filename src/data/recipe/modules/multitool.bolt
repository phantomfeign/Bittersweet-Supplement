from beet import Recipe
from utils:tiers import TIERS, TIER_LOOKUP,NUMBER_LOOKUP

MULTITOOL_CRAFTING = [
    {
        "base_tier": "golden",
        "base_item": "gold_ingot",
        "added_item": "amethyst_shard",
    },
    {
        "base_tier": "iron",
        "base_item": "iron_ingot",
        "added_item": "gold_ingot",
    },
    {
        "base_tier": "copper",
        "base_item": "copper_ingot",
        "added_item": "iron_ingot",
    }
]

#MATTOCK_CRAFTING
for tool in MULTITOOL_CRAFTING:
    current_tier = TIER_LOOKUP[tool["base_tier"]]
    mining_speed = current_tier["mining_speed"]
    max_durability = int(current_tier["durability"]*1.5)
    ctx.data.recipes[f"bswt:multitool/crafted/mattock/{tool['base_tier']}"] = Recipe({

        "type": "minecraft:crafting_shaped",
        "category": "equipment",
        "pattern": [
            "XXP",
            " #X",
            "# X"
        ],
        "key": {
            "#": "minecraft:stick",
            "X": f"minecraft:{tool["base_item"]}",
            "P": f"minecraft:{tool['added_item']}"
        },
        "result": {
            "id": f"minecraft:{tool['base_tier']}_hoe",
            "components": {
                "minecraft:item_name": {"translate": f"item.bswt.{tool['base_tier']}_mattock", "italic": False},
                "minecraft:item_model": f"bswt_texture:{tool['base_tier']}_mattock",
                "minecraft:custom_data": {"bswt:multitool":"mattock"},
                "minecraft:tooltip_display": {"hidden_components": ["minecraft:attribute_modifiers"]},
                "minecraft:lore": [{"text": f"{mining_speed}⛏", "color": "gold", "italic": False}],
                "minecraft:max_damage": max_durability,
                "minecraft:tool": {
                    "rules": [
                        {
                            "blocks": "#minecraft:mineable/pickaxe",
                            "speed": mining_speed,
                            "correct_for_drops": True
                        },
                        {
                            "blocks": "#minecraft:mineable/hoe",
                            "speed": mining_speed,
                            "correct_for_drops": True
                        }
                    ],
                    "default_mining_speed": 1,
                    "damage_per_block": 1
                }
            }
        }
    })

